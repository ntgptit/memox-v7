import '../tables/decks.drift';
import '../tables/cards.drift';

-- Typed queries for the Deck management vertical (M4.9, M4.9a).
--
-- Tree reads resolve through `root_deck_id`, never by coalescing the parent
-- column with the id (BR-57): that expression means "my parent, or me if I
-- have none" and returns the wrong deck from the third level down.
--
-- Subtree walks use a recursive CTE with UNION — not UNION ALL — so a node is
-- visited once even if the stored tree is cyclic (corrupt): the duplicate row
-- is discarded and the recursion terminates with the COMPLETE reachable set.
-- No depth cap appears here on purpose. A cap turns corrupt data into a
-- silently truncated result — a card count that lies to the delete dialog, a
-- root rewrite that skips nodes (exactly the Q6 violation) — where the UNION
-- walk returns everything or, for genuinely unreachable data, nothing at all.
-- Cycle DETECTION stays where it lives: invariant Q8, whose diagnostic cap is
-- its own concern.
--
-- The two *probe* queries walk with a :maxWalk bound instead, because their
-- rows carry a depth column that defeats UNION deduplication. The bound is a
-- parameter, derived by the caller from the single domain constant
-- (`DeckEntity.maxTreeDepth`, BR-55) — hitting it is reported to the caller
-- (`reachedRoot` false / height at the bound) and treated as a failure, never
-- as a shorter answer.

-- Root decks for the list screen (UC-06 reads it; M4.9 provides it).
rootDecks:
SELECT * FROM decks
WHERE parent_deck_id IS NULL
ORDER BY created_at ASC, id ASC;

-- Root decks with their aggregate progress — the whole of UC-06 step 1 in ONE
-- statement (M4.10).
--
-- **Why the two counts are joined subqueries, not correlated ones.** Each
-- inner SELECT groups the cards table once and the outer query joins the
-- result, so the work does not repeat per root. A correlated subquery, or the
-- obvious Dart loop calling `subtreeCardCount` per deck, is the N+1 UC-06
-- names by name — invisible with three decks and the reason the screen stalls
-- with three hundred.
--
-- Both counts reach descendants through `root_deck_id` (BR-56, BR-57, AD-10),
-- never by walking parents: a deck at level 3 has the same `root_deck_id` as
-- the root, which is exactly the property that makes this a flat GROUP BY
-- instead of a recursive walk.
--
-- **The due predicate below is character-for-character the one in
-- `study.drift`.** BR-22 defines "due" once, and the badge on this list has to
-- agree with the list a session then hands out; two spellings drift apart the
-- first time one is edited. `query_test.dart` asserts all three agree on the
-- same data and the same `:now`.
--
-- `:now` is a parameter, never a SQL clock function — a query that reads the
-- clock itself cannot be tested at the `due_at = now` boundary, and that
-- boundary has to work.
--
-- A root with no cards yields no row from either subquery, hence COALESCE to
-- 0. That is a count of nothing, not a missing parent — this file resolves
-- roots only through `root_deck_id`, per BR-57.
-- **`nextDueAt` is in this statement and not in a second one.** It is the
-- earliest instant at which any `dueCardCount` above would change, and the list
-- screen schedules its next re-measure from it — so the count and the moment it
-- expires have to describe the same snapshot. Read separately they could not:
-- the boundary would be computed from a database state the counts were not, and
-- the screen would refresh at an instant that was right for neither.
--
-- `> :now`, strictly, and the same `:now` the counts use. A card due exactly at
-- `:now` is already counted by the predicate above, so including it here would
-- schedule a wake for a boundary that has already been crossed — a timer firing
-- at zero delay, forever.
--
-- One scalar subquery, evaluated once per statement, and `idx_review_states_due`
-- makes it a single index seek rather than a scan. NULL means nothing is
-- scheduled to become due at all, which is a real state — every card due, or no
-- cards — and the screen must not set a timer for it.
rootDeckSummaries:
SELECT
    d.**,
    COALESCE(total.cardCount, 0) AS totalCardCount,
    COALESCE(due.dueCount, 0) AS dueCardCount,
    (
        SELECT MIN(next.due_at) FROM card_review_states next
        WHERE next.due_at > :now
    ) AS nextDueAt
FROM decks d
LEFT JOIN (
    SELECT cd.root_deck_id AS rootDeckId, COUNT(*) AS cardCount
    FROM cards c
    INNER JOIN decks cd ON cd.id = c.deck_id
    GROUP BY cd.root_deck_id
) total ON total.rootDeckId = d.id
LEFT JOIN (
    SELECT cd.root_deck_id AS rootDeckId, COUNT(*) AS dueCount
    FROM cards c
    INNER JOIN decks cd ON cd.id = c.deck_id
    INNER JOIN card_review_states s ON s.card_id = c.id
    WHERE (s.due_at IS NULL OR s.due_at <= :now)
    GROUP BY cd.root_deck_id
) due ON due.rootDeckId = d.id
WHERE d.parent_deck_id IS NULL
ORDER BY d.created_at ASC, d.id ASC;

-- Every deck in the database, ordered so a tree can be rebuilt from it.
--
-- One statement for the move-target picker (UC-09). The alternative —
-- `decksInTree` once per root — is N+1 in the number of trees, and the picker
-- has to show every tree by definition. Depth and ancestry are then derived in
-- memory from the parent pointers already in these rows; that is arithmetic
-- over one result set, not a walk that hits the database again.
--
-- The repository still re-validates every rule at submit time. What the UI
-- computes from this is which options to *offer*; what may actually be written
-- is decided by `moveDeck` (BR-55, BR-64, BR-70, BR-74).
allDecks:
SELECT * FROM decks
ORDER BY root_deck_id ASC, created_at ASC, id ASC;

deckById:
SELECT * FROM decks WHERE id = :deckId;

-- One root's whole tree, root included, at any allowed depth. No recursion
-- needed: every descendant already carries the root's id (BR-56).
decksInTree:
SELECT * FROM decks
WHERE root_deck_id = :rootDeckId
ORDER BY created_at ASC, id ASC;

-- One deck and its direct children, from ONE statement (UC-06 step 4, UC-08).
--
-- **Why one statement and not two.** The screen's action set is computed from
-- both facts at once: which actions exist comes from the deck's `content_type`,
-- and whether *reset* is offered comes from the children being empty (BR-68). Two
-- reads mean two database snapshots, so the screen could render an action matrix
-- from a deck captured at one instant and a child list captured at another — and
-- the window is real, because a rename or a create lands between them.
--
-- The previous shape watched `childDecks` and then asked `deckById` per emission.
-- Its comment said both facts "arrive together"; they did not.
--
-- `LEFT JOIN`, so a deck with no children still yields exactly one row with a
-- null child. A deck that does not exist yields none, which is how the repository
-- tells the difference between "empty" and "gone" without a second query.
deckDetail:
SELECT deck.**, child.**
FROM decks AS deck
LEFT JOIN decks AS child ON child.parent_deck_id = deck.id
WHERE deck.id = :deckId
ORDER BY child.created_at ASC, child.id ASC;

-- An arbitrary deck's subtree — itself plus every descendant.
subtreeDeckIds:
WITH RECURSIVE subtree (id) AS (
    SELECT id FROM decks WHERE id = :deckId
    UNION
    SELECT d.id
    FROM decks d
    INNER JOIN subtree s ON d.parent_deck_id = s.id
)
SELECT id FROM subtree;

-- How deep a deck sits, walking parents upward. The deck itself is step 1, so
-- for an intact chain the greatest depth equals the deck's level with the
-- root as level 1 (BR-55), and the row holding it has a NULL parent —
-- `reachedRoot`. A walk that exhausts :maxWalk without reaching a root means
-- the chain is longer than the caller allows, or cyclic; either way the
-- caller must refuse, not guess.
deckDepthProbe:
WITH RECURSIVE ancestry (node_id, parent_id, depth) AS (
    SELECT id, parent_deck_id, 1 FROM decks WHERE id = :deckId
    UNION ALL
    SELECT d.id, d.parent_deck_id, a.depth + 1
    FROM decks d
    INNER JOIN ancestry a ON d.id = a.parent_id
    WHERE a.depth < :maxWalk
)
SELECT depth AS depth, parent_id IS NULL AS reachedRoot
FROM ancestry
ORDER BY depth DESC
LIMIT 1;

-- How tall a subtree is, with the deck itself as height 1. A result equal to
-- :maxWalk means "at least this tall" — taller than any tree the caller
-- permits, or cyclic — and the caller must refuse.
subtreeHeightProbe:
WITH RECURSIVE walk (id, height) AS (
    SELECT id, 1 FROM decks WHERE id = :deckId
    UNION ALL
    SELECT d.id, w.height + 1
    FROM decks d
    INNER JOIN walk w ON d.parent_deck_id = w.id
    WHERE w.height < :maxWalk
)
SELECT MAX(height) AS height FROM walk;

-- Direct children only — the emptiness check for BR-68.
directChildDeckCount:
SELECT COUNT(*) AS childCount FROM decks WHERE parent_deck_id = :deckId;

directCardCount:
SELECT COUNT(*) AS cardCount FROM cards WHERE deck_id = :deckId;

-- Cards in a whole subtree, for the deletion confirm (BR-04).
subtreeCardCount:
WITH RECURSIVE subtree (id) AS (
    SELECT id FROM decks WHERE id = :deckId
    UNION
    SELECT d.id
    FROM decks d
    INNER JOIN subtree s ON d.parent_deck_id = s.id
)
SELECT COUNT(*) AS cardCount
FROM cards c
WHERE c.deck_id IN (SELECT id FROM subtree);

-- Rewrites the root pointer for a whole subtree in one statement (BR-71).
-- Runs inside the move transaction; a failure anywhere rolls the lot back.
updateSubtreeRootDeck:
UPDATE decks
SET root_deck_id = :newRootDeckId, updated_at = :updatedAt
WHERE id IN (
    WITH RECURSIVE subtree (id) AS (
        SELECT id FROM decks WHERE id = :deckId
        UNION
        SELECT d.id
        FROM decks d
        INNER JOIN subtree s ON d.parent_deck_id = s.id
    )
    SELECT id FROM subtree
);
