import '../tables/decks.drift';
import '../tables/cards.drift';

-- Typed queries for the Deck management vertical (M4.9, M4.9a).
--
-- Tree reads resolve through `root_deck_id`, never by coalescing the parent
-- column with the id (BR-57): that expression means "my parent, or me if I
-- have none" and returns the wrong deck from the third level down.
--
-- Subtree walks use a recursive CTE with UNION — not UNION ALL — so a node is
-- visited once even if the stored tree is cyclic (corrupt): the duplicate row
-- is discarded and the recursion terminates with the COMPLETE reachable set.
-- No depth cap appears here on purpose. A cap turns corrupt data into a
-- silently truncated result — a card count that lies to the delete dialog, a
-- root rewrite that skips nodes (exactly the Q6 violation) — where the UNION
-- walk returns everything or, for genuinely unreachable data, nothing at all.
-- Cycle DETECTION stays where it lives: invariant Q8, whose diagnostic cap is
-- its own concern.
--
-- The two *probe* queries walk with a :maxWalk bound instead, because their
-- rows carry a depth column that defeats UNION deduplication. The bound is a
-- parameter, derived by the caller from the single domain constant
-- (`DeckEntity.maxTreeDepth`, BR-55) — hitting it is reported to the caller
-- (`reachedRoot` false / height at the bound) and treated as a failure, never
-- as a shorter answer.

-- Root decks for the list screen (UC-06 reads it; M4.9 provides it).
rootDecks:
SELECT * FROM decks
WHERE parent_deck_id IS NULL
ORDER BY created_at ASC, id ASC;

-- Root decks with their aggregate progress — the whole of UC-06 step 1 in ONE
-- statement (M4.10).
--
-- **Why the two counts are joined subqueries, not correlated ones.** Each
-- inner SELECT groups the cards table once and the outer query joins the
-- result, so the work does not repeat per root. A correlated subquery, or the
-- obvious Dart loop calling `subtreeCardCount` per deck, is the N+1 UC-06
-- names by name — invisible with three decks and the reason the screen stalls
-- with three hundred.
--
-- Both counts reach descendants through `root_deck_id` (BR-56, BR-57, AD-10),
-- never by walking parents: a deck at level 3 has the same `root_deck_id` as
-- the root, which is exactly the property that makes this a flat GROUP BY
-- instead of a recursive walk.
--
-- **The due predicate below is character-for-character the one in
-- `study.drift`.** BR-22 defines "due" once, and the badge on this list has to
-- agree with the list a session then hands out; two spellings drift apart the
-- first time one is edited. `query_test.dart` asserts all three agree on the
-- same data and the same `:now`.
--
-- `:now` is a parameter, never a SQL clock function — a query that reads the
-- clock itself cannot be tested at the `due_at = now` boundary, and that
-- boundary has to work.
--
-- A root with no cards yields no row from either subquery, hence COALESCE to
-- 0. That is a count of nothing, not a missing parent — this file resolves
-- roots only through `root_deck_id`, per BR-57.
-- **`nextDueAt` is in this statement and not in a second one.** It is the
-- earliest instant at which any `dueCardCount` above would change, and the list
-- screen schedules its next re-measure from it — so the count and the moment it
-- expires have to describe the same snapshot. Read separately they could not:
-- the boundary would be computed from a database state the counts were not, and
-- the screen would refresh at an instant that was right for neither.
--
-- `> :now`, strictly, and the same `:now` the counts use. A card due exactly at
-- `:now` is already counted by the predicate above, so including it here would
-- schedule a wake for a boundary that has already been crossed — a timer firing
-- at zero delay, forever.
--
-- One scalar subquery, evaluated once per statement, and `idx_card_study_states_due`
-- makes it a single index seek rather than a scan. NULL means nothing is
-- scheduled to become due at all, which is a real state — every card due, or no
-- cards — and the screen must not set a timer for it.
rootDeckSummaries:
SELECT
    d.**,
    COALESCE(total.cardCount, 0) AS totalCardCount,
    COALESCE(new.newCount, 0) AS newCardCount,
    COALESCE(due.dueCount, 0) AS dueCardCount,
    COALESCE(due.overdueCount, 0) AS overdueCardCount,
    due.oldestDueAt AS oldestDueAt,
    COALESCE(learned.learnedCount, 0) AS learnedCardCount,
    COALESCE(sub.subCount, 0) AS subDeckCount,
    (
        SELECT MIN(next.due_at) FROM card_study_states next
        WHERE next.due_at > :now
    ) AS nextDueAt
FROM decks d
-- BR-90, BR-150. The badge's other number: cards that have not finished the
-- learning chain. Character-for-character the predicate `newCardsInTree` in
-- `study.drift` selects with, because the badge and the session it opens have
-- to count the same set — `query_test.dart` holds all of them to one answer.
-- Disjoint from `due` by construction: one is `learned_at IS NULL`, the other
-- `IS NOT NULL`, so no card can be in both and the two may be summed.
LEFT JOIN (
    SELECT cd.root_deck_id AS rootDeckId, COUNT(*) AS newCount
    FROM cards c
    INNER JOIN decks cd ON cd.id = c.deck_id
    INNER JOIN card_study_states s ON s.card_id = c.id
    WHERE s.learned_at IS NULL
    GROUP BY cd.root_deck_id
) new ON new.rootDeckId = d.id
LEFT JOIN (
    SELECT cd.root_deck_id AS rootDeckId, COUNT(*) AS cardCount
    FROM cards c
    INNER JOIN decks cd ON cd.id = c.deck_id
    GROUP BY cd.root_deck_id
) total ON total.rootDeckId = d.id
-- `oldestDueAt` rides the same grouped subquery as the count (BR-161): it is
-- the `due_at` of the subtree's oldest due card, which is what the overdue
-- badge measures its days from. Same predicate, same snapshot, no second
-- statement.
--
-- `overdueCount` splits the same set, in the same pass (BR-162): of the due
-- cards this GROUP BY already visits, how many came due before today began.
-- `:startOfToday` is the local day boundary computed by the caller from
-- `LocalDayModel` (BR-105) — SQL never derives a local midnight itself, for
-- the same reason `:now` is a parameter and not a clock function. The set is
-- a partition, so `dueCount = overdueCount + (due today)` by construction,
-- and crossing local midnight moves cards between the halves with no write:
-- the next read simply carries a later boundary.
LEFT JOIN (
    SELECT cd.root_deck_id AS rootDeckId, COUNT(*) AS dueCount,
           SUM(CASE WHEN s.due_at < :startOfToday THEN 1 ELSE 0 END)
               AS overdueCount,
           MIN(s.due_at) AS oldestDueAt
    FROM cards c
    INNER JOIN decks cd ON cd.id = c.deck_id
    INNER JOIN card_study_states s ON s.card_id = c.id
    WHERE s.learned_at IS NOT NULL AND s.due_at <= :now
    GROUP BY cd.root_deck_id
) due ON due.rootDeckId = d.id
-- BR-88. `card_study_states` carries `scheduler_type` denormalised, so the
-- predicate needs no join back to decks -- and the denormalisation is what makes
-- the two branches checkable in one pass instead of two queries.
LEFT JOIN (
    SELECT cd.root_deck_id AS rootDeckId, COUNT(*) AS learnedCount
    FROM cards c
    INNER JOIN decks cd ON cd.id = c.deck_id
    INNER JOIN card_study_states s ON s.card_id = c.id
    WHERE (s.scheduler_type = 'eight_box' AND s.current_box = 8)
       OR (s.scheduler_type = 'sm2' AND s.interval_days >= 128)
    GROUP BY cd.root_deck_id
) learned ON learned.rootDeckId = d.id
-- Direct children only, not the subtree: the row says "3 sub-decks", and a
-- reader counts what they will see after tapping it.
LEFT JOIN (
    SELECT parent_deck_id AS parentId, COUNT(*) AS subCount
    FROM decks
    WHERE parent_deck_id IS NOT NULL
    GROUP BY parent_deck_id
) sub ON sub.parentId = d.id
WHERE d.parent_deck_id IS NULL
ORDER BY d.created_at ASC, d.id ASC;

-- Every deck in the database, ordered so a tree can be rebuilt from it.
--
-- One statement for the move-target picker (UC-09). The alternative —
-- `decksInTree` once per root — is N+1 in the number of trees, and the picker
-- has to show every tree by definition. Depth and ancestry are then derived in
-- memory from the parent pointers already in these rows; that is arithmetic
-- over one result set, not a walk that hits the database again.
--
-- The repository still re-validates every rule at submit time. What the UI
-- computes from this is which options to *offer*; what may actually be written
-- is decided by `moveDeck` (BR-55, BR-64, BR-70, BR-74).
allDecks:
SELECT * FROM decks
ORDER BY root_deck_id ASC, created_at ASC, id ASC;

deckById:
SELECT * FROM decks WHERE id = :deckId;

-- One root's whole tree, root included, at any allowed depth. No recursion
-- needed: every descendant already carries the root's id (BR-56).
decksInTree:
SELECT * FROM decks
WHERE root_deck_id = :rootDeckId
ORDER BY created_at ASC, id ASC;

-- One deck and its direct children, each child carrying the aggregate of its
-- WHOLE subtree — the same three facts `rootDeckSummaries` gives a root.
--
-- **Why this exists at all.** Opening a deck used to show a plainer list than the
-- one the user came from: names only, no counts, no state. Two screens for one
-- idea, and the difference was not a design decision — it was the shape of the
-- data leaking upward, because `deckDetail` returned bare rows.
--
-- **Why it needs recursion where `rootDeckSummaries` does not.** A root's subtree
-- is free: every descendant already carries its `root_deck_id`, so the aggregate
-- is a flat GROUP BY. No column identifies an *intermediate* ancestor, so the
-- subtree of a deck at level 3 has to be walked. `branch` does that once for the
-- whole level: it maps every descendant to which direct child of :parentId it
-- belongs under, and the two aggregates then group on that.
--
-- UNION, not UNION ALL, for the same reason as every other walk in this file: a
-- cyclic tree from corrupt data terminates with the complete reachable set
-- instead of hanging. BR-55 caps real depth at 10, so the walk is short.
--
-- **The scheduler comes from the root** (BR-06): a sub-deck's own columns are
-- NULL by rule, and the review it is part of uses the root's. Reading it here
-- rather than leaving the caller to look it up keeps the level one statement.
--
-- **`nextDueAt` is scoped to this level's subtrees, unlike the root's.** The
-- root screen shows every tree, so the whole database is its horizon and the
-- global MIN in `rootDeckSummaries` is correct there. A level inside a deck
-- shows only the child subtrees the `branch` walk maps — a card scheduled in
-- some unrelated tree changing state does not move any number on this screen,
-- and a boundary taken from it would wake the controller to re-run this query
-- for a snapshot guaranteed identical. So the scalar reads through `branch`:
-- the earliest instant at which one of *these* counts changes, or NULL when
-- nothing on this level is scheduled to. Same `:now` as the counts, and
-- strictly `>`: a card due exactly at `:now` is already inside `dueCount`,
-- and returning it here would schedule a zero-delay timer, forever.
--
-- **`ancestryJson` — the path back up, in this same statement.** The breadcrumb
-- has to agree with the title. Renaming an ancestor while a descendant is open
-- must move both or neither, and a second query is a second snapshot (AD-13).
--
-- It is a **JSON scalar, and that is a deliberate hole** in this file's rule that
-- every column is type-checked at build time. Two typed shapes were tried first
-- and both are worse. Joining `ancestry` onto the child rows multiplies the
-- result set by the depth — 100 children at level 5 becomes 400 rows where 100
-- would do, and M4.10 measured that what costs on the UI thread is rows crossing
-- the isolate boundary, not SQL time. A `UNION ALL` returning ancestors as extra
-- rows would be free and fully typed, but drift does NOT expand `table.**` inside
-- a compound select: it emits the literal `parent.**` into the SQL string with no
-- error, so the query cannot run. Both were verified against drift 2.34 before
-- this shape was chosen.
--
-- So one scalar, repeated per row exactly like `nextDueAt`, decoded in the mapper.
-- Nothing above the repository ever sees a string.
--
-- `distance` is carried inside each object rather than relied on as row order.
-- SQLite does not promise the order an aggregate consumes its input, so the chain
-- is sorted in Dart, where the guarantee is real.
--
-- The walk stops at the root because `parent_deck_id IS NOT NULL` guards the
-- recursive step, and UNION rather than UNION ALL terminates on corrupt cyclic
-- data. The current deck is deliberately NOT in the chain — it is `parent.**`
-- above, and putting it in both places would let one read disagree with itself.
childDeckLevel:
WITH RECURSIVE
branch (branch_id, deck_id) AS (
    SELECT id, id FROM decks WHERE parent_deck_id = :parentId
    UNION
    SELECT b.branch_id, d.id
    FROM decks d
    INNER JOIN branch b ON d.parent_deck_id = b.deck_id
),
ancestry (deck_id, distance) AS (
    SELECT parent_deck_id, 1 FROM decks
    WHERE id = :parentId AND parent_deck_id IS NOT NULL
    UNION
    SELECT d.parent_deck_id, a.distance + 1
    FROM decks d
    INNER JOIN ancestry a ON d.id = a.deck_id
    WHERE d.parent_deck_id IS NOT NULL
)
SELECT
    parent.**,
    child.**,
    root.scheduler_type AS inheritedSchedulerType,
    COALESCE(total.cardCount, 0) AS totalCardCount,
    COALESCE(new.newCount, 0) AS newCardCount,
    COALESCE(due.dueCount, 0) AS dueCardCount,
    COALESCE(due.overdueCount, 0) AS overdueCardCount,
    due.oldestDueAt AS oldestDueAt,
    COALESCE(learned.learnedCount, 0) AS learnedCardCount,
    COALESCE(sub.subCount, 0) AS subDeckCount,
    (
        SELECT MIN(next.due_at)
        FROM branch fb
        INNER JOIN cards fc ON fc.deck_id = fb.deck_id
        INNER JOIN card_study_states next ON next.card_id = fc.id
        WHERE next.due_at > :now
    ) AS nextDueAt,
    (
        SELECT json_group_array(
            json_object('id', a.deck_id, 'name', d.name, 'distance', a.distance)
        )
        FROM ancestry a
        INNER JOIN decks d ON d.id = a.deck_id
    ) AS ancestryJson
FROM decks AS parent
LEFT JOIN decks AS child ON child.parent_deck_id = parent.id
LEFT JOIN decks AS root ON root.id = child.root_deck_id
LEFT JOIN (
    SELECT b.branch_id AS branchId, COUNT(*) AS cardCount
    FROM branch b
    INNER JOIN cards c ON c.deck_id = b.deck_id
    GROUP BY b.branch_id
) total ON total.branchId = child.id
-- BR-90, BR-150, per branch. Same predicate as the root query above, repeated
-- for the same reason the learned one is: drift generates from the statement
-- text, and a view would put the rule somewhere neither query names.
LEFT JOIN (
    SELECT b.branch_id AS branchId, COUNT(*) AS newCount
    FROM branch b
    INNER JOIN cards c ON c.deck_id = b.deck_id
    INNER JOIN card_study_states s ON s.card_id = c.id
    WHERE s.learned_at IS NULL
    GROUP BY b.branch_id
) new ON new.branchId = child.id
-- BR-161, per branch: the oldest due card of each child's subtree, same
-- predicate and same grouped pass as the count. `overdueCount` partitions the
-- same set at `:startOfToday` (BR-162), exactly as the root query does — see
-- the comment there for why the boundary is a parameter.
LEFT JOIN (
    SELECT b.branch_id AS branchId, COUNT(*) AS dueCount,
           SUM(CASE WHEN s.due_at < :startOfToday THEN 1 ELSE 0 END)
               AS overdueCount,
           MIN(s.due_at) AS oldestDueAt
    FROM branch b
    INNER JOIN cards c ON c.deck_id = b.deck_id
    INNER JOIN card_study_states s ON s.card_id = c.id
    WHERE s.learned_at IS NOT NULL AND s.due_at <= :now
    GROUP BY b.branch_id
) due ON due.branchId = child.id
-- BR-88, per branch. Same predicate as the root query above; it is repeated
-- rather than factored into a view because drift generates from the statement
-- text and a view would put the rule somewhere neither query names.
LEFT JOIN (
    SELECT b.branch_id AS branchId, COUNT(*) AS learnedCount
    FROM branch b
    INNER JOIN cards c ON c.deck_id = b.deck_id
    INNER JOIN card_study_states s ON s.card_id = c.id
    WHERE (s.scheduler_type = 'eight_box' AND s.current_box = 8)
       OR (s.scheduler_type = 'sm2' AND s.interval_days >= 128)
    GROUP BY b.branch_id
) learned ON learned.branchId = child.id
-- Direct children of each child, same reason as the root query.
LEFT JOIN (
    SELECT parent_deck_id AS parentId, COUNT(*) AS subCount
    FROM decks
    WHERE parent_deck_id IS NOT NULL
    GROUP BY parent_deck_id
) sub ON sub.parentId = child.id
WHERE parent.id = :parentId
ORDER BY child.created_at ASC, child.id ASC;

-- An arbitrary deck's subtree — itself plus every descendant.
subtreeDeckIds:
WITH RECURSIVE subtree (id) AS (
    SELECT id FROM decks WHERE id = :deckId
    UNION
    SELECT d.id
    FROM decks d
    INNER JOIN subtree s ON d.parent_deck_id = s.id
)
SELECT id FROM subtree;

-- How deep a deck sits, walking parents upward. The deck itself is step 1, so
-- for an intact chain the greatest depth equals the deck's level with the
-- root as level 1 (BR-55), and the row holding it has a NULL parent —
-- `reachedRoot`. A walk that exhausts :maxWalk without reaching a root means
-- the chain is longer than the caller allows, or cyclic; either way the
-- caller must refuse, not guess.
deckDepthProbe:
WITH RECURSIVE ancestry (node_id, parent_id, depth) AS (
    SELECT id, parent_deck_id, 1 FROM decks WHERE id = :deckId
    UNION ALL
    SELECT d.id, d.parent_deck_id, a.depth + 1
    FROM decks d
    INNER JOIN ancestry a ON d.id = a.parent_id
    WHERE a.depth < :maxWalk
)
SELECT depth AS depth, parent_id IS NULL AS reachedRoot
FROM ancestry
ORDER BY depth DESC
LIMIT 1;

-- How tall a subtree is, with the deck itself as height 1. A result equal to
-- :maxWalk means "at least this tall" — taller than any tree the caller
-- permits, or cyclic — and the caller must refuse.
subtreeHeightProbe:
WITH RECURSIVE walk (id, height) AS (
    SELECT id, 1 FROM decks WHERE id = :deckId
    UNION ALL
    SELECT d.id, w.height + 1
    FROM decks d
    INNER JOIN walk w ON d.parent_deck_id = w.id
    WHERE w.height < :maxWalk
)
SELECT MAX(height) AS height FROM walk;

-- Direct children only — the emptiness check for BR-68.
directChildDeckCount:
SELECT COUNT(*) AS childCount FROM decks WHERE parent_deck_id = :deckId;

directCardCount:
SELECT COUNT(*) AS cardCount FROM cards WHERE deck_id = :deckId;

-- Cards in a whole subtree, for the deletion confirm (BR-04).
subtreeCardCount:
WITH RECURSIVE subtree (id) AS (
    SELECT id FROM decks WHERE id = :deckId
    UNION
    SELECT d.id
    FROM decks d
    INNER JOIN subtree s ON d.parent_deck_id = s.id
)
SELECT COUNT(*) AS cardCount
FROM cards c
WHERE c.deck_id IN (SELECT id FROM subtree);

-- Rewrites the root pointer for a whole subtree in one statement (BR-71).
-- Runs inside the move transaction; a failure anywhere rolls the lot back.
updateSubtreeRootDeck:
UPDATE decks
SET root_deck_id = :newRootDeckId, updated_at = :updatedAt
WHERE id IN (
    WITH RECURSIVE subtree (id) AS (
        SELECT id FROM decks WHERE id = :deckId
        UNION
        SELECT d.id
        FROM decks d
        INNER JOIN subtree s ON d.parent_deck_id = s.id
    )
    SELECT id FROM subtree
);

-- Every card in a tree, back to the state a card is born in (BR-42, BR-09).
--
-- **One statement, because BR-47 says one transaction and this is the bulk of
-- it.** A per-card loop would be the same writes with more places to stop
-- halfway, and the tree is the unit the rule talks about.
--
-- `learned_at` and `due_at` go NULL together (BR-152): a card with one and not
-- the other is exactly what invariants 24 and 28 exist to catch. The per-
-- scheduler columns arrive as parameters rather than as two statements — the
-- caller already knows which scheduler is being written, and a second UPDATE
-- would be a second chance for the two to disagree.
--
-- `study_answers` is untouched. The old history stays, carrying the old
-- generation (BR-43).
resetTreeStudyStates:
UPDATE card_study_states
SET scheduler_type = :schedulerType,
    scheduler_generation = :generation,
    learned_at = NULL,
    due_at = NULL,
    last_answered_at = NULL,
    answer_count = 0,
    lapse_count = 0,
    current_box = :currentBox,
    ease_factor = :easeFactor,
    interval_days = :intervalDays,
    repetitions = :repetitions
WHERE card_id IN (
  SELECT c.id
  FROM cards c
  INNER JOIN decks d ON d.id = c.deck_id
  WHERE d.root_deck_id = :rootDeckId
);
