import '../tables/decks.drift';
import '../tables/cards.drift';
import '../tables/study.drift';

-- Business queries for a study session.
--
-- **Two card sets, never mixed** (BR-142). `learning` takes cards that have not
-- finished the chain; `reviewing` takes cards that finished it and have come
-- due. The old single "study queue" of BR-22 is gone, and with it the padding
-- that filled a session to twenty cards with material the user never asked to
-- learn.
--
-- **One definition per set, used by the count and by the list.** The number
-- shown before a session has to agree with what the session then hands out; two
-- spellings of the same predicate drift apart the first time one is edited, and
-- the symptom is a badge saying 12 while the session offers 11 — which reads as
-- a scheduler bug and is not one.
--
-- **`:now` is a parameter, never the SQL clock function.** A query that reads
-- the clock itself cannot be tested at a boundary, and "due exactly at now" is a
-- boundary that has to work.
--
-- **No scheduler interval appears here.** The eight-box day table and the SM-2
-- factors belong to the scheduler (BR-16); SQL only asks whether the stored
-- `due_at` has arrived.
--
-- All three tree reads join through `root_deck_id` rather than walking parents
-- (BR-57, AD-10). Coalescing the parent column with the id means "my parent, or
-- me if I have none", which returns the level-2 deck for anything at level 3 —
-- right for a one-level tree, which is what makes it dangerous.

-- Cards that have not finished the learning chain, for a `learning` session.
--
-- Ordered by creation, which is `new_card_order = created` (BR-148). The
-- `random` ordering is applied by the repository after this read: `RANDOM()` in
-- SQL cannot be seeded, so a shuffle done here could not be tested.
newCardsInTree:
SELECT c.**
FROM cards c
INNER JOIN decks d ON d.id = c.deck_id
INNER JOIN card_study_states s ON s.card_id = c.id
WHERE d.root_deck_id = :rootDeckId
  AND s.learned_at IS NULL
ORDER BY c.created_at ASC, c.id ASC
LIMIT :limit;

-- Every unlearned card of a tree, for `new_card_order = random` (BR-148).
--
-- **No LIMIT, and that is the whole difference.** Applying the ceiling in SQL
-- and shuffling afterwards reorders a set that was already chosen by
-- `created_at` — and BR-113 reshuffles every stage anyway, so the reordering is
-- invisible and the option has no effect at all. Choosing at random means
-- choosing from everything, so the limit is applied after the shuffle.
--
-- Bounded by the deck-s unlearned cards, and only read when the user picked
-- `random`.
newCardsInTreeAll:
SELECT c.**
FROM cards c
INNER JOIN decks d ON d.id = c.deck_id
INNER JOIN card_study_states s ON s.card_id = c.id
WHERE d.root_deck_id = :rootDeckId
  AND s.learned_at IS NULL
ORDER BY c.created_at ASC, c.id ASC;

-- Cards that finished the chain and have come due, for a `reviewing` session.
--
-- `due_at` ascending is BR-23. No `IS NULL` branch: since v5 a card without a
-- schedule is one that has not been learned, and it belongs to the other set.
dueCardsInTree:
SELECT c.**
FROM cards c
INNER JOIN decks d ON d.id = c.deck_id
INNER JOIN card_study_states s ON s.card_id = c.id
WHERE d.root_deck_id = :rootDeckId
  AND s.learned_at IS NOT NULL
  AND s.due_at <= :now
ORDER BY s.due_at ASC, c.id ASC
LIMIT :limit;

-- Everything the study entry point needs, in one statement (AD-13).
--
-- The badge needs two numbers (BR-150) and the mode chooser needs one per mode
-- (BR-154). Read separately they are separate snapshots, and the screen can then
-- draw a badge from before a write beside a chooser from after it.
--
-- **It takes the deck the user opened, root or branch, and resolves the root
-- itself** (BR-06, BR-57). It used to take a root id and be handed whatever the
-- screen had: every caller happened to pass a root, so a study entry opened on a
-- *sub-deck* counted nothing and told the learner every card was already
-- learned. The subquery is also what keeps these counts agreeing with what a
-- session would actually serve — `openSession` takes the whole root tree.
--
-- `fillable` is the count `fill` can actually take: that mode needs an
-- `example`, and it is optional, so a twenty-card review can be three cards long
-- in that mode. `distinctMeanings` is what `guess` needs five of (BR-121,
-- BR-123) — counted on `back_folded`, because two cards that merely *display*
-- differently are still the same meaning and must not share an option set.
studyEntryCounts:
SELECT
  SUM(CASE WHEN s.learned_at IS NULL THEN 1 ELSE 0 END) AS newCount,
  SUM(CASE WHEN s.learned_at IS NOT NULL AND s.due_at <= :now
           THEN 1 ELSE 0 END) AS dueCount,
  SUM(CASE WHEN s.learned_at IS NOT NULL AND s.due_at <= :now
                AND c.example IS NOT NULL AND TRIM(c.example) <> ''
           THEN 1 ELSE 0 END) AS fillableCount,
  COUNT(DISTINCT CASE WHEN s.learned_at IS NOT NULL AND s.due_at <= :now
                      THEN c.back_folded END) AS distinctMeanings
FROM cards c
INNER JOIN decks d ON d.id = c.deck_id
INNER JOIN card_study_states s ON s.card_id = c.id
WHERE d.root_deck_id = (SELECT root_deck_id FROM decks WHERE id = :deckId);

-- The next card to serve (BR-23, BR-26).
--
-- `round ASC` before `position ASC` is what moves a round-based stage forward
-- without anything having to notice a round ended: once every row of round N is
-- `completed`, the lowest pending round *is* N+1.
--
-- `available_at <= :cursor` is BR-26's comeback. A forgotten card is pushed to
-- `cursor + 3` and nothing else moves; the blunt alternative — rewriting
-- `position` and shifting every row after it — turns one wrong answer into a
-- burst of updates and loses the original order.
--
-- An empty result with rows still `pending` means every remaining card is
-- waiting out that gap, which is not the same as the stage being finished. That
-- is why `pendingInStage` exists separately.
nextQueueItem:
SELECT *
FROM study_queue_items
WHERE session_id = :sessionId
  AND mode = :mode
  AND status = 'pending'
  AND available_at <= :cursor
ORDER BY round ASC, position ASC, card_id ASC
LIMIT 1;

-- How many rows of this stage are still pending, at any round.
pendingInStage:
SELECT COUNT(*) AS pendingCount
FROM study_queue_items
WHERE session_id = :sessionId AND mode = :mode AND status = 'pending';

-- How far the running round of a stage has got: how many of its cards are done,
-- and how many it holds.
--
-- **One round, not the whole stage.** A stage that has enrolled a failed card
-- into round N+1 would otherwise show a total that grows while the user answers,
-- and a bar that goes backwards reads as a bug rather than as a second pass.
--
-- **One statement, not two counts.** The screen shows the figure and the bar
-- from the same pair; read separately they can straddle a write and the bar ends
-- up drawn against a total from before the answer that just landed (AD-13).
--
-- It counts rows of this stage only, so it can never mix the two card sets
-- BR-142 keeps apart — a session holds one of them and its queue holds no other.
stageRoundProgress:
SELECT
  COUNT(*) AS total,
  COUNT(*) FILTER (WHERE status <> 'pending') AS done
FROM study_queue_items
WHERE session_id = :sessionId AND mode = :mode AND round = :round;

-- Which cards of a round are already done.
--
-- **The board's ticks are data, not widget memory** (§4). A paired tile stays on
-- the board and stops being a target — and the screen swaps to its loading state
-- between turns, which unmounts the board and takes that memory with it. Every
-- pair then became tappable again and the same card could be answered twice.
-- Read here, the marks survive anything the widget tree does.
-- **Ordered by position, and the order is load-bearing** (BR-155). `match` reads
-- this as a set of ticks and could not tell, but `browse` walks it backwards as
-- the trail of cards already seen — and a round serves each card once, in
-- `position` order, so `position` order is the order they were seen in.
--
-- Without the `ORDER BY` this returned position order anyway: the planner picks
-- the index on (session_id, mode, round) and that walks in position order. It
-- was measured — rows re-inserted in reverse still came back in position order,
-- and the test that tried to catch it stayed green. Which is the reason the
-- clause is here rather than the reason it is not: the app needs the order, and
-- an order that is a property of the current query plan is one nobody will be
-- told about when the plan changes.
completedCardsInRound:
SELECT card_id
FROM study_queue_items
WHERE session_id = :sessionId AND mode = :mode AND round = :round
  AND status <> 'pending'
ORDER BY position;

-- Every card of a round, answered or not, in the order the round serves them.
--
-- **`match` deals a round into boards and needs to know what the round holds**
-- (BR-156). It was dealing from the session's whole card list instead, which is
-- the same thing only in round 1: from round 2 the queue holds just the cards
-- that failed (BR-115) while the board still laid out all of them, so the
-- counter said `0 / 3` under a board of ten.
--
-- `position` order for the same reason `completedCardsInRound` uses it: it is
-- the round's own shuffle (BR-117), it is stable across a Resume, and a board
-- that re-chunked itself on every read would move a pair out from under the
-- finger about to press it.
cardsInRound:
SELECT card_id
FROM study_queue_items
WHERE session_id = :sessionId AND mode = :mode AND round = :round
ORDER BY position;

-- The lowest pending round of a stage — the round currently being served.
currentRoundOf:
SELECT MIN(round) AS round
FROM study_queue_items
WHERE session_id = :sessionId AND mode = :mode AND status = 'pending';

-- One queue row.
queueItemAt:
SELECT *
FROM study_queue_items
WHERE session_id = :sessionId
  AND mode = :mode
  AND round = :round
  AND card_id = :cardId;

-- The distinct cards a session holds, from its first stage's first round.
--
-- Every stage runs over the same card set (BR-113), so this is the set BR-24's
-- ceiling was applied to — and the set invariant 18 counts.
sessionCardIds:
SELECT DISTINCT card_id AS cardId
FROM study_queue_items
WHERE session_id = :sessionId;

-- Sessions left open by an earlier study day (BR-103).
staleOpenSessions:
SELECT *
FROM study_sessions
WHERE status = 'in_progress' AND started_at < :dayStart;

-- The session currently open for a deck, if any.
openSessionForDeck:
SELECT *
FROM study_sessions
WHERE deck_id = :deckId AND status = 'in_progress'
ORDER BY started_at DESC
LIMIT 1;

-- The app-wide study defaults (BR-147). Always exactly one row.
appSettingsRow:
SELECT * FROM app_settings WHERE id = 1;

-- The review set of one tree, and the same set counted per tree.
--
-- **The predicate below is character-for-character `dueCardsInTree`'s**, minus
-- the limit. The count shown before a session has to agree with the list the
-- session then hands out; two spellings drift apart the first time one is
-- edited, and the symptom is a badge saying 12 while the session offers 11 —
-- which reads as a scheduler bug and is not one. `query_test.dart` asserts the
-- two agree on the same data and the same `now`.
cardsDueForStudy:
SELECT c.**
FROM cards c
INNER JOIN decks d ON d.id = c.deck_id
INNER JOIN card_study_states s ON s.card_id = c.id
WHERE d.root_deck_id = :rootDeckId
  AND s.learned_at IS NOT NULL
  AND s.due_at <= :now
ORDER BY s.due_at ASC, c.id ASC;

dueCountPerRootDeck:
SELECT d.root_deck_id AS rootDeckId, COUNT(*) AS dueCount
FROM cards c
INNER JOIN decks d ON d.id = c.deck_id
INNER JOIN card_study_states s ON s.card_id = c.id
WHERE s.learned_at IS NOT NULL AND s.due_at <= :now
GROUP BY d.root_deck_id
ORDER BY d.root_deck_id ASC;

-- Locks the root's scheduler the first time a card in its tree finishes the
-- learning chain (BR-13, BR-144).
--
-- **One statement, and every clause in it is load-bearing.**
--
-- `first_answered_at IS NULL` in the WHERE is what makes this idempotent and
-- what stops the second card overwriting the first card's timestamp. Reading
-- the column and then deciding in Dart would be the same race with two round
-- trips: two cards finishing in one session would both read NULL.
--
-- The root is resolved through `root_deck_id`. The coalesce-the-parent shortcut
-- BR-57 bans returns the level-2 deck from the third level down.
--
-- `updated_at` is deliberately untouched. Learning a card is not an edit to the
-- deck, and bumping it would jump the deck to the top of Recent for something
-- the user did inside it rather than to it.
lockRootSchedulerIfUnlocked:
UPDATE decks SET first_answered_at = :firstAnsweredAt
WHERE id = (
    SELECT d.root_deck_id FROM cards c
    INNER JOIN decks d ON d.id = c.deck_id
    WHERE c.id = :cardId
  )
  AND first_answered_at IS NULL;

-- The Study tab's own workload read: every root deck, with the three counts the
-- Home list orders by (BR-200, BR-201).
--
-- **A statement of its own, and not `rootDeckSummaries` borrowed.** The two
-- carry the same predicates on purpose and `query_test.dart` holds them to one
-- answer on the same data and the same `:now` — the same contract every other
-- pair of "count it" / "list it" queries in this file lives under. What they do
-- **not** share is a reason to exist: the deck list needs a whole deck row, a
-- learned gauge and a direct-child count, and Study Home needs none of those.
-- Reusing the other statement would make a filter added for one screen a change
-- in the behaviour of the other, which is the coupling AD-13 keeps out of reads.
--
-- **The due set is split at the local-day boundary, in the same grouped pass**
-- (BR-162). `:startOfToday` is computed by the caller from `LocalDayModel`
-- (BR-105); SQL never derives a local midnight, for the same reason `:now` is a
-- parameter and not a clock function. The two halves partition the Reviewing set
-- of BR-142 — no third session kind, no change to what a session serves.
--
-- **`new` is `learned_at IS NULL`**, character-for-character `newCardsInTree`'s
-- predicate, so the number on the row and the session it opens count one set.
--
-- Bounded: one row per root deck, three grouped subqueries evaluated once each.
-- The obvious Dart loop asking per deck is the N+1 this shape exists to refuse.
--
-- Roots with no cards are still returned. Filtering them out here would make
-- "the library has decks but none of them holds a card" indistinguishable from
-- "the library is empty", and those are two different screens (BR-202).
--
-- Ordering is `created_at` — a stable read order, **not** the order the list is
-- drawn in. BR-201 ranks by workload and breaks ties on the case-folded name,
-- and SQLite's `lower()` folds ASCII only: it leaves `Ô`, `Ê` and `Đ` alone, so
-- a Vietnamese deck name would sort by whether it happened to start with a
-- diacritic. The fold is Dart's, the same decision `CardText.folded` records.
studyHomeRootWorkload:
SELECT
  d.id AS deckId,
  d.name AS deckName,
  d.scheduler_type AS schedulerType,
  COALESCE(total.cardCount, 0) AS totalCardCount,
  COALESCE(new.newCount, 0) AS newCount,
  COALESCE(due.overdueCount, 0) AS overdueCount,
  COALESCE(due.dueTodayCount, 0) AS dueTodayCount,
  (
    SELECT MIN(next.due_at) FROM card_study_states next
    WHERE next.due_at > :now
  ) AS nextDueAt
FROM decks d
LEFT JOIN (
    SELECT cd.root_deck_id AS rootDeckId, COUNT(*) AS cardCount
    FROM cards c
    INNER JOIN decks cd ON cd.id = c.deck_id
    GROUP BY cd.root_deck_id
) total ON total.rootDeckId = d.id
LEFT JOIN (
    SELECT cd.root_deck_id AS rootDeckId, COUNT(*) AS newCount
    FROM cards c
    INNER JOIN decks cd ON cd.id = c.deck_id
    INNER JOIN card_study_states s ON s.card_id = c.id
    WHERE s.learned_at IS NULL
    GROUP BY cd.root_deck_id
) new ON new.rootDeckId = d.id
LEFT JOIN (
    SELECT cd.root_deck_id AS rootDeckId,
           SUM(CASE WHEN s.due_at < :startOfToday THEN 1 ELSE 0 END)
               AS overdueCount,
           SUM(CASE WHEN s.due_at >= :startOfToday THEN 1 ELSE 0 END)
               AS dueTodayCount
    FROM cards c
    INNER JOIN decks cd ON cd.id = c.deck_id
    INNER JOIN card_study_states s ON s.card_id = c.id
    WHERE s.learned_at IS NOT NULL AND s.due_at <= :now
    GROUP BY cd.root_deck_id
) due ON due.rootDeckId = d.id
WHERE d.parent_deck_id IS NULL
ORDER BY d.created_at ASC, d.id ASC;

-- The one session Study Home may offer to continue (BR-200).
--
-- **Every disqualification is a clause here, and none of them is a write.**
-- Home renders; it does not repair. BR-103's repair — closing a session an
-- earlier study day left open as `abandoned`/`interrupted` — still belongs to
-- `abandonStaleSessions`, which runs when the user actually enters the flow. A
-- Home screen that closed sessions would write to the database for scrolling
-- past a card, and would do it on every rebuild.
--
-- So the four ways a session stops being resumable are read as filters:
--
-- * `status = 'in_progress'` — a session that ended is not offered back.
-- * `started_at >= :dayStart` — a session from an earlier study day is over
--   whether or not anybody has closed it yet (BR-103). Advertising it would
--   promise a Resume that the next `abandonStaleSessions` cancels.
-- * `root.scheduler_generation = s.scheduler_generation` — a session opened
--   before a Reset can no longer write anything (BR-84), so offering to
--   continue it offers a session that fails on its first answer. The INNER JOIN
--   is the other half: a root that is gone matches nothing, and `deck_id`'s
--   own cascade has already taken the session with a deleted deck.
-- * `EXISTS (…queue…)` — the session holds no queue row at all. That is what
--   "every card of the session was deleted" looks like from here, because
--   `study_queue_items.card_id` cascades. Deliberately *not* narrowed to
--   `status = 'pending'`: BR-200 says "the session's queue still holds at least
--   one row", and a stricter clause would be a second, quieter rule. A session
--   whose rows are all `completed` is closed in the same transaction that
--   completes the last one, so it never reaches this query as `in_progress`.
--
-- Newest first: two open sessions on different decks is a state BR-101 does not
-- forbid, and the one the user was last in is the one they mean.
studyHomeResumeCandidate:
SELECT
  s.id AS sessionId,
  s.deck_id AS deckId,
  d.name AS deckName,
  s.session_kind AS sessionKind,
  s.current_mode AS currentMode
FROM study_sessions s
INNER JOIN decks d ON d.id = s.deck_id
INNER JOIN decks root ON root.id = s.root_deck_id
WHERE s.status = 'in_progress'
  AND s.started_at >= :dayStart
  AND root.scheduler_generation = s.scheduler_generation
  AND EXISTS (
    SELECT 1 FROM study_queue_items q WHERE q.session_id = s.id
  )
ORDER BY s.started_at DESC, s.id ASC
LIMIT 1;
