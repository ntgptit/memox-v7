import '../tables/cards.drift';
import '../tables/tags.drift';
import '../tables/study.drift';

-- Typed queries for the Card side of the Deck/Card vertical (M4.9a).
--
-- Pure card reads live here; queries a Deck use case needs about cards —
-- `directCardCount` for the content-type reset, `subtreeCardCount` for the
-- deletion confirm — stay in deck.drift with the deck boundary that calls
-- them.

-- The management list for one deck: newest first, bounded by a caller-supplied
-- window.
--
-- **`DESC`, and the direction is load-bearing.** Cards were ordered oldest-first
-- until M4.11, which put a just-created card at the *far end* of the deck — the
-- opposite of what UC-04 A4 (add several in a row) needs to show. It also made
-- the window expensive exactly where it is used most: with the newest rows last,
-- seeing them means holding the whole deck open, and `watch()` re-reads that
-- window on every insert. Newest-first keeps the add-many flow at one page.
--
-- This order is a **management** view and decides nothing about study: the
-- study queue is `cardsDueForStudy` in study.drift, ordered by BR-23.
--
-- `created_at`, never `updated_at` — editing an old card would otherwise move it
-- to the top and take the reader's place in the list with it.
--
-- **`LIMIT` with no `OFFSET`, and no cursor.** The window grows (50, 100, 150…)
-- and is re-read whole, so an insert above it cannot duplicate or drop a row the
-- way a shifting offset window does. A keyset cursor buys nothing until
-- something seeks deep without reading what is before it — no MVP flow does, as
-- there is still no card search (S1, deferred). What the composite index
-- `(deck_id, created_at, id)` buys *is* realised here: it supplies the order, so
-- `LIMIT` stops early instead of sorting the deck and putting a lid on it.
cardsByDeck:
SELECT * FROM cards
WHERE deck_id = :deckId
ORDER BY created_at DESC, id DESC
LIMIT :limit;

-- The management list, joined to each card's study state so the row can show
-- its state dot and label without a second read per card (D5, BR-89…BR-91).
--
-- **`INNER JOIN`, and it is safe because BR-09 makes it total:** every card is
-- born with exactly one study state in the same transaction, so no card can be
-- missing its state row. The join therefore drops nothing, and reads the state
-- for the whole window in one statement rather than N.
--
-- **`c.**, s.**` — two nested rows, not a flattened select.** drift maps each
-- star to its own row class (`Card`, `CardReviewState`), which the repository
-- hands to the existing two mappers; a flat select would need a hand-written
-- result class that duplicates both. Same order and window as `cardsByDeck`, so
-- C1 and C2 hold identically.
--
-- **The tag names ride along as a `GROUP_CONCAT`, not a second read (D5).** A
-- correlated subquery over `card_tags`/`tags` folds each card's tags into one
-- unit-separated string, so the row draws its chips without a call per card.
-- `char(31)` (the ASCII unit separator) is the delimiter — it cannot occur
-- inside a `TagName`, which is trimmed printable text, so the split back apart
-- is unambiguous. NULL for a card with no tags.
--
-- **The subquery's tables do NOT reach the generated stream dependencies.**
-- drift 2.34's analyzer omits `card_tags`/`tags` from this query's `readsFrom`
-- (moving the join into `FROM` as a derived table changed nothing), so on its
-- own the watch emits once and goes silent when a tag is added or removed —
-- the row keeps showing stale chips until something else touches `cards`
-- (found by IT-ORG-007/008). `CardDao.watchCardListItems` completes the
-- dependency set with `tableUpdates` over the two missing tables;
-- `card_list_tag_invalidation_test.dart` pins the repaired behaviour.
cardListItems:
SELECT
  c.**,
  s.**,
  (
    SELECT GROUP_CONCAT(t.name, char(31))
    FROM card_tags ct
    INNER JOIN tags t ON t.id = ct.tag_id
    WHERE ct.card_id = c.id
  ) AS tag_names
FROM cards c
INNER JOIN card_study_states s ON s.card_id = c.id
WHERE $predicate
ORDER BY $order
LIMIT :limit;

-- How many cards a predicate matches, for "showing 50 of 3,240" and every pill.
--
-- **The same `$predicate` the list takes, without the window**, so a pill can
-- never disagree with the list it opens: one definition of "due", of "new", of a
-- search term, used by both. A separate statement from the list on purpose —
-- `COUNT(*) OVER ()` beside the rows would make SQLite materialise every
-- matching row, which is precisely the early stop the `LIMIT` and the index buy.
cardCount:
SELECT COUNT(*) FROM cards c
INNER JOIN card_study_states s ON s.card_id = c.id
WHERE $predicate;

-- Just the ids a predicate matches, for Select all (BR-167).
--
-- **The same `$predicate` as the list and the count**, so "select all" selects
-- exactly what the screen is showing — one definition of due, of new, of a
-- search term, shared by three statements. A second predicate here is how a
-- user ends up deleting rows they had filtered away.
--
-- **Ids only, and no `LIMIT`.** The window belongs to the list; a selection
-- covers the whole result set by definition. Returning `cards.**` would carry
-- every front, back and detail across the isolate boundary to compute a set of
-- strings — the reason this is a separate statement rather than a reuse of
-- `cardListItems`.
cardIdsMatching:
SELECT c.id FROM cards c
INNER JOIN card_study_states s ON s.card_id = c.id
WHERE $predicate;

-- Where each card lives, and which tree that deck belongs to (BR-165).
--
-- One statement for the whole batch: a move validates same-root, non-root
-- target and target content type, and doing that per card would be N reads
-- inside the transaction for a question one join answers.
cardDeckContextForIds:
SELECT c.id AS cardId, d.id AS deckId, d.root_deck_id AS rootDeckId,
       d.parent_deck_id AS parentDeckId, d.content_type AS contentType
FROM cards c
INNER JOIN decks d ON d.id = c.deck_id
WHERE c.id IN :cardIds;

-- The three bulk writes. Each is one statement over an id list, so a batch is
-- one round trip and one atomic step rather than N of each (BR-166).
moveCardsToDeck:
UPDATE cards SET deck_id = :deckId, updated_at = :updatedAt
WHERE id IN :cardIds;

deleteCardsByIds:
DELETE FROM cards WHERE id IN :cardIds;

setCardsFlagByIds:
UPDATE cards SET is_flagged = :isFlagged, updated_at = :updatedAt
WHERE id IN :cardIds;

-- How many tags each card in the batch already carries, for the BR-94 cap.
-- Cards with no tags are absent from the result, which the caller reads as 0.
tagCountsForCards:
SELECT ct.card_id AS cardId, COUNT(*) AS tagCount
FROM card_tags AS ct
WHERE ct.card_id IN :cardIds
GROUP BY ct.card_id;

-- Which cards of the batch already carry this tag, so linking is idempotent
-- (BR-166) and the cap counts only the cards that would actually gain one.
cardsAlreadyTagged:
SELECT ct.card_id AS cardId FROM card_tags AS ct
WHERE ct.card_id IN :cardIds AND ct.tag_id = :tagId;

cardById:
SELECT * FROM cards WHERE id = :cardId;

-- ---- card detail and history (BR-182…BR-188) -------------------------------

-- One card's content, its current schedule and its tag names, for the detail
-- screen (BR-183).
--
-- **`cardListItems` narrowed to one id, and deliberately the same shape.** The
-- two nested stars map to `Card` and `CardStudyState`, which the existing two
-- mappers already turn into entities, and the tags ride along as the same
-- `char(31)`-joined `GROUP_CONCAT` — so detail and the row it was opened from
-- cannot disagree about a card's state or its chips.
--
-- **`INNER JOIN`, total for the same reason:** BR-09 creates the study state in
-- the same transaction as the card, so no card can be missing one. A card id
-- that matches nothing therefore means the card is gone, which is exactly the
-- signal BR-188 needs — and it is why this returns no row rather than a row
-- with nulls.
--
-- **The tag subquery's tables DO reach this statement's generated
-- `readsFrom`**, so this watch needs no hand-merged `tableUpdates`. Checked in
-- the generated code rather than inherited from the note on `cardListItems`
-- above, which was written against an earlier drift and no longer describes
-- what that statement generates either. Copying the workaround on the strength
-- of the comment would have subscribed to the tag tables twice and emitted two
-- frames for one tag edit. What is pinned is the behaviour, not the mechanism:
-- `card_detail_repository_test.dart` asserts that adding a tag re-emits, so the
-- day drift changes its mind the test is what says so.
cardDetailById:
SELECT
  c.**,
  s.**,
  (
    SELECT GROUP_CONCAT(t.name, char(31))
    FROM card_tags ct
    INNER JOIN tags t ON t.id = ct.tag_id
    WHERE ct.card_id = c.id
  ) AS tag_names
FROM cards c
INNER JOIN card_study_states s ON s.card_id = c.id
WHERE c.id = :cardId;

-- The newest page of one card's review history (BR-184).
--
-- **`SELECT *`, so drift maps the row to `StudyAnswer` and one mapper turns it
-- into the read model.** A hand-listed projection would be a second place the
-- sixteen stored columns are named, and BR-185's whole point is that the screen
-- shows what the row stored — a column dropped from a projection is a fact that
-- silently stops being displayed.
--
-- **`answered_at DESC, id DESC`, and the tie-break is load-bearing.** Two turns
-- of one session can share a millisecond; without `id` the order is not total,
-- and a page boundary that falls inside a group of equal timestamps loses rows
-- or repeats them no matter how the cursor is built.
--
-- `idx_study_answers_card (card_id, answered_at)` supplies the `card_id`
-- equality and the leading sort term, scanned backwards. SQLite's block sort
-- then orders only within each equal-`answered_at` group, so the `LIMIT` still
-- stops early instead of sorting the card's whole history and putting a lid on
-- it — `card_history_repository_test.dart` pins that by reading the query plan.
--
-- The caller asks for one row more than the page size and reports what it
-- found: "is there another page" answered by the read rather than guessed from
-- a short result.
cardHistoryFirstPage:
SELECT * FROM study_answers
WHERE card_id = :cardId
ORDER BY answered_at DESC, id DESC
LIMIT :limit;

-- The same page, resumed after a keyset cursor (BR-184).
--
-- **A second statement rather than a nullable cursor on the one above**, the
-- same choice `flaggedCardsByDeck` makes and for the same reason: an
-- `(:hasCursor = 0 OR …)` chain is a predicate SQLite cannot use the index to
-- stop early through, which would undo exactly what the index is for.
--
-- The pair `(answered_at, id)` is compared long-hand rather than as an SQLite
-- row value: drift's analyzer does not parse row-value comparison, and a
-- statement that fails to type-check at build time is worse than three lines of
-- explicit boolean algebra.
--
-- **Strictly after, never `<=`.** The cursor is the last row of the previous
-- page; including it again is the duplicate BR-184 forbids.
cardHistoryAfter:
SELECT * FROM study_answers
WHERE card_id = :cardId
  AND (
    answered_at < :answeredAt
    OR (answered_at = :answeredAt AND id < :id)
  )
ORDER BY answered_at DESC, id DESC
LIMIT :limit;

studyStateByCard:
SELECT * FROM card_study_states WHERE card_id = :cardId;

-- The same window as `cardsByDeck`, narrowed to flagged cards (BR-92).
--
-- **A separate statement rather than a mode parameter on the one above.** A
-- single query with `(:mode = 'all' OR (:mode = 'flagged' AND is_flagged = 1))`
-- reads as less duplication and costs the index: SQLite cannot use
-- `(deck_id, created_at, id)` to stop early through an OR chain, so the filtered
-- list would sort the whole deck and put a lid on it — undoing the 1193us → 102us
-- the composite index was measured to buy.
flaggedCardsByDeck:
SELECT * FROM cards
WHERE deck_id = :deckId AND is_flagged = 1
ORDER BY created_at DESC, id DESC
LIMIT :limit;

-- The four numbers behind the deck progress panel (BR-89…BR-91, BR-88).
--
-- **Every threshold arrives as a parameter, and that is the point.** BR-16 keeps
-- the box ladder and the SM-2 factors in the scheduler, so a literal here would
-- make changing the algorithm a migration. Passing them in leaves Dart —
-- `card_state_model.dart` — as the one place the numbers are written, and this
-- query as arithmetic that knows nothing about which scheduler it is counting.
--
-- The count has to be SQL rather than Dart: the panel describes the whole deck
-- while the list holds a window, so projecting in Dart would mean reading every
-- study state to produce four integers.
--
-- `learned_at IS NULL` is tested first and separately, mirroring `cardStateOf`:
-- `eight_box` seeds `current_box = 1` at creation (BR-09), so a card that has
-- not finished the learning chain would otherwise be counted as beginning.
--
-- It replaced `answer_count = 0` at v5. The learning chain writes no `scheduled`
-- answer (BR-144), so the old test called a card new no matter how many stages
-- it had been through.
cardStateCountsByDeck:
SELECT
  COUNT(*) AS total,
  SUM(CASE WHEN s.learned_at IS NULL THEN 1 ELSE 0 END) AS newCount,
  SUM(CASE WHEN s.learned_at IS NOT NULL AND (
        (s.scheduler_type = 'eight_box' AND s.current_box < :reviewingBox)
     OR (s.scheduler_type = 'sm2' AND s.interval_days < :reviewingDays)
  ) THEN 1 ELSE 0 END) AS beginningCount,
  SUM(CASE WHEN s.learned_at IS NOT NULL AND (
        (s.scheduler_type = 'eight_box'
           AND s.current_box >= :reviewingBox AND s.current_box < :masteredBox)
     OR (s.scheduler_type = 'sm2'
           AND s.interval_days >= :reviewingDays
           AND s.interval_days < :masteredDays)
  ) THEN 1 ELSE 0 END) AS reviewingCount,
  SUM(CASE WHEN s.learned_at IS NOT NULL AND (
        (s.scheduler_type = 'eight_box' AND s.current_box >= :masteredBox)
     OR (s.scheduler_type = 'sm2' AND s.interval_days >= :masteredDays)
  ) THEN 1 ELSE 0 END) AS masteredCount
FROM cards AS c
INNER JOIN card_study_states AS s ON s.card_id = c.id
WHERE c.deck_id = :deckId;

-- The card list header: the deck's own name and the path of ancestors above it,
-- in one statement so the title and the breadcrumb agree in the same frame (W1,
-- AD-13). A rename of an ancestor moves both or neither.
--
-- **`ancestryJson` is a JSON scalar, the same deliberate hole `childDeckLevel`
-- opens and for the same reason.** Joining the ancestry chain onto the row would
-- multiply a single deck's read by its depth; a typed compound select cannot use
-- `table.**`. So the chain is one scalar, decoded in the mapper, and `distance`
-- rides inside each object because SQLite does not promise aggregate input order
-- — the mapper sorts root-first where the guarantee is real.
--
-- The current deck is deliberately NOT in the chain: it is `deckName` here, and
-- putting it in both would let the title and the last crumb disagree. The walk
-- stops at the root (`parent_deck_id IS NOT NULL` guards the step) and UNION, not
-- UNION ALL, terminates on corrupt cyclic data — BR-55 caps real depth at 10.
--
-- `contentType` rides along so `readDeckHoldsCards` need not run a second read
-- for the router's auto-forward; nothing above the repository sees the string.
deckContextById:
WITH RECURSIVE ancestry (deck_id, distance) AS (
    SELECT parent_deck_id, 1 FROM decks
    WHERE id = :deckId AND parent_deck_id IS NOT NULL
    UNION
    SELECT d.parent_deck_id, a.distance + 1
    FROM decks d
    INNER JOIN ancestry a ON d.id = a.deck_id
    WHERE d.parent_deck_id IS NOT NULL
)
SELECT
    self.name AS deckName,
    self.content_type AS contentType,
    (
        SELECT json_group_array(
            json_object('id', a.deck_id, 'name', d.name, 'distance', a.distance)
        )
        FROM ancestry a
        INNER JOIN decks d ON d.id = a.deck_id
    ) AS ancestryJson
FROM decks self
WHERE self.id = :deckId;

-- The duplicate identities already in one deck, for import's BR-170 check —
-- one statement for the whole preview and again for the in-transaction
-- recheck, never a per-row lookup.
cardKeysInDeck:
SELECT front_folded, back_folded FROM cards WHERE deck_id = :deckId;

-- The tags a batch would reuse, by folded identity (BR-93) — array-bound so
-- an import with thirty distinct tags is one statement, not thirty.
tagsByFoldedNames:
SELECT * FROM tags WHERE name_folded IN :foldedNames;

-- ---- export (BR-174, BR-177) ----------------------------------------------

-- The deck's own name, for the exported file's name (BR-180).
--
-- Read inside the same transaction as the rows below, never beside them: the
-- name and the cards are one snapshot (BR-177), and a file whose name came
-- from before a rename while its rows came from after it is a file nobody can
-- explain. `deckContextById` would answer this too and costs a recursive
-- ancestry walk for a breadcrumb no export renders — and it returns no row for
-- a deck that is gone, which is exactly the signal `deckMissing` needs.
exportDeckName:
SELECT name FROM decks WHERE id = :deckId;

-- Every card held **directly** by one deck, with its tags, for scope `all`
-- (BR-174).
--
-- **`ASC`, and the direction is the export contract rather than the list's.**
-- `cardsByDeck` is newest-first because a management list is read from the top;
-- an export is read as a document, and BR-177 fixes `created_at ASC` with an
-- `id ASC` tie-break so the same deck always produces the same bytes. The
-- composite index `(deck_id, created_at, id)` supplies this order directly, so
-- there is no temp B-tree either way.
--
-- **No `LIMIT`, no filter, no descendants.** The user asked for the deck, not
-- for the view of it they happened to be looking at, and `deck_id = :deckId`
-- is a direct-children test — a descendant deck's cards carry that deck's id.
--
-- **The tags ride along as a `GROUP_CONCAT`, not a read per card (BR-177).**
-- The same correlated subquery `cardListItems` uses, with the same `char(31)`
-- unit separator — which `TagName.parse` now refuses outright, so the split on
-- the other side is safe by construction rather than by assumption. NULL for a
-- card with no tags.
--
-- **No `ORDER BY` inside the aggregate, deliberately.** One sat here as a
-- "courtesy" and was a no-op: the subquery returns a single row, so the clause
-- sorted a one-row result and promised nothing about the order the names were
-- concatenated in — which SQLite does not define. Leaving it in read as a
-- guarantee that did not exist. The repository sorts the split-apart names by
-- folded name, which is where BR-177 puts the guarantee and the only place it
-- actually holds.
--
-- `id` and `created_at` are selected although no exported field carries them
-- (BR-175): the id is what tells the repository which requested id did not come
-- back, and `created_at` is what re-establishes the total order across the
-- chunks of the query below. Both stop at the repository.
exportCardsInDeck AS ExportCardRow:
SELECT
  c.id AS cardId,
  c.created_at AS createdAt,
  c.front AS front,
  c.back AS back,
  c.example AS example,
  c.hint AS hint,
  c.pronunciation AS pronunciation,
  (
    SELECT GROUP_CONCAT(t.name, char(31))
    FROM card_tags ct
    INNER JOIN tags t ON t.id = ct.tag_id
    WHERE ct.card_id = c.id
  ) AS tagNames
FROM cards c
WHERE c.deck_id = :deckId
ORDER BY c.created_at ASC, c.id ASC;

-- The same row, narrowed to an exact id set, for scope `selected` (BR-174).
--
-- **`AS ExportCardRow` on both, so drift generates one result class**: the two
-- scopes differ in which cards they name and in nothing else, and a second row
-- class would let one of them grow a column the other does not have.
--
-- **`deck_id = :deckId` as well as the id list, and that pair is the rule.** An
-- id that was deleted and an id that moved to another deck both simply fail to
-- come back, so one statement answers both halves of BR-174 — the repository
-- subtracts what returned from what it asked for and refuses the whole request
-- if anything is missing. Counting rows could not do that: the scope already
-- normalized duplicates away, so a short result and a stale id are
-- indistinguishable by count alone.
--
-- Array-bound, and the caller chunks the list — see `CardExportDao.idChunkSize`
-- for SQLite's bind-variable ceiling. Chunking is why the repository re-sorts:
-- each statement is ordered, the concatenation of several is not.
exportCardsByIds AS ExportCardRow:
SELECT
  c.id AS cardId,
  c.created_at AS createdAt,
  c.front AS front,
  c.back AS back,
  c.example AS example,
  c.hint AS hint,
  c.pronunciation AS pronunciation,
  (
    SELECT GROUP_CONCAT(t.name, char(31))
    FROM card_tags ct
    INNER JOIN tags t ON t.id = ct.tag_id
    WHERE ct.card_id = c.id
  ) AS tagNames
FROM cards c
WHERE c.deck_id = :deckId AND c.id IN :cardIds
ORDER BY c.created_at ASC, c.id ASC;
