import '../tables/cards.drift';

-- Typed queries for the Card side of the Deck/Card vertical (M4.9a).
--
-- Pure card reads live here; queries a Deck use case needs about cards —
-- `directCardCount` for the content-type reset, `subtreeCardCount` for the
-- deletion confirm — stay in deck.drift with the deck boundary that calls
-- them.

-- The management list for one deck: newest first, bounded by a caller-supplied
-- window.
--
-- **`DESC`, and the direction is load-bearing.** Cards were ordered oldest-first
-- until M4.11, which put a just-created card at the *far end* of the deck — the
-- opposite of what UC-04 A4 (add several in a row) needs to show. It also made
-- the window expensive exactly where it is used most: with the newest rows last,
-- seeing them means holding the whole deck open, and `watch()` re-reads that
-- window on every insert. Newest-first keeps the add-many flow at one page.
--
-- This order is a **management** view and decides nothing about study: the
-- review queue is `cardsDueForReview` in study.drift, ordered by BR-23.
--
-- `created_at`, never `updated_at` — editing an old card would otherwise move it
-- to the top and take the reader's place in the list with it.
--
-- **`LIMIT` with no `OFFSET`, and no cursor.** The window grows (50, 100, 150…)
-- and is re-read whole, so an insert above it cannot duplicate or drop a row the
-- way a shifting offset window does. A keyset cursor buys nothing until
-- something seeks deep without reading what is before it — no MVP flow does, as
-- there is still no card search (S1, deferred). What the composite index
-- `(deck_id, created_at, id)` buys *is* realised here: it supplies the order, so
-- `LIMIT` stops early instead of sorting the deck and putting a lid on it.
cardsByDeck:
SELECT * FROM cards
WHERE deck_id = :deckId
ORDER BY created_at DESC, id DESC
LIMIT :limit;

-- The management list, joined to each card's review state so the row can show
-- its state dot and label without a second read per card (D5, BR-89…BR-91).
--
-- **`INNER JOIN`, and it is safe because BR-09 makes it total:** every card is
-- born with exactly one review state in the same transaction, so no card can be
-- missing its state row. The join therefore drops nothing, and reads the state
-- for the whole window in one statement rather than N.
--
-- **`c.**, s.**` — two nested rows, not a flattened select.** drift maps each
-- star to its own row class (`Card`, `CardReviewState`), which the repository
-- hands to the existing two mappers; a flat select would need a hand-written
-- result class that duplicates both. Same order and window as `cardsByDeck`, so
-- C1 and C2 hold identically.
cardListItemsByDeck:
SELECT c.**, s.**
FROM cards c
INNER JOIN card_review_states s ON s.card_id = c.id
WHERE c.deck_id = :deckId
ORDER BY c.created_at DESC, c.id DESC
LIMIT :limit;

-- How many cards the deck holds, for "showing 50 of 3,240".
--
-- A separate statement on purpose. `COUNT(*) OVER ()` beside the rows above
-- would make SQLite materialise every matching row to compute it, which is
-- precisely the early stop the `LIMIT` and the index exist to buy.
cardCountByDeck:
SELECT COUNT(*) FROM cards WHERE deck_id = :deckId;

cardById:
SELECT * FROM cards WHERE id = :cardId;

reviewStateByCard:
SELECT * FROM card_review_states WHERE card_id = :cardId;

-- The same window as `cardsByDeck`, narrowed to flagged cards (BR-92).
--
-- **A separate statement rather than a mode parameter on the one above.** A
-- single query with `(:mode = 'all' OR (:mode = 'flagged' AND is_flagged = 1))`
-- reads as less duplication and costs the index: SQLite cannot use
-- `(deck_id, created_at, id)` to stop early through an OR chain, so the filtered
-- list would sort the whole deck and put a lid on it — undoing the 1193us → 102us
-- the composite index was measured to buy.
flaggedCardsByDeck:
SELECT * FROM cards
WHERE deck_id = :deckId AND is_flagged = 1
ORDER BY created_at DESC, id DESC
LIMIT :limit;

-- The number on the flag filter pill.
flaggedCountByDeck:
SELECT COUNT(*) FROM cards WHERE deck_id = :deckId AND is_flagged = 1;

-- The four numbers behind the deck progress panel (BR-89…BR-91, BR-88).
--
-- **Every threshold arrives as a parameter, and that is the point.** BR-16 keeps
-- the box ladder and the SM-2 factors in the scheduler, so a literal here would
-- make changing the algorithm a migration. Passing them in leaves Dart —
-- `card_state_model.dart` — as the one place the numbers are written, and this
-- query as arithmetic that knows nothing about which scheduler it is counting.
--
-- The count has to be SQL rather than Dart: the panel describes the whole deck
-- while the list holds a window, so projecting in Dart would mean reading every
-- review state to produce four integers.
--
-- `review_count = 0` is tested first and separately, mirroring `cardStateOf`:
-- `eight_box` seeds `current_box = 1` at creation (BR-09), so a card that has
-- never been reviewed would otherwise be counted as beginning.
cardStateCountsByDeck:
SELECT
  COUNT(*) AS total,
  SUM(CASE WHEN s.review_count = 0 THEN 1 ELSE 0 END) AS newCount,
  SUM(CASE WHEN s.review_count > 0 AND (
        (s.scheduler_type = 'eight_box' AND s.current_box < :reviewingBox)
     OR (s.scheduler_type = 'sm2' AND s.interval_days < :reviewingDays)
  ) THEN 1 ELSE 0 END) AS beginningCount,
  SUM(CASE WHEN s.review_count > 0 AND (
        (s.scheduler_type = 'eight_box'
           AND s.current_box >= :reviewingBox AND s.current_box < :masteredBox)
     OR (s.scheduler_type = 'sm2'
           AND s.interval_days >= :reviewingDays
           AND s.interval_days < :masteredDays)
  ) THEN 1 ELSE 0 END) AS reviewingCount,
  SUM(CASE WHEN s.review_count > 0 AND (
        (s.scheduler_type = 'eight_box' AND s.current_box >= :masteredBox)
     OR (s.scheduler_type = 'sm2' AND s.interval_days >= :masteredDays)
  ) THEN 1 ELSE 0 END) AS masteredCount
FROM cards AS c
INNER JOIN card_review_states AS s ON s.card_id = c.id
WHERE c.deck_id = :deckId;
