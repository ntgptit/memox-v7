import 'decks.drift';
import 'trash.drift';

-- Card content, and the schedule that is kept apart from it.
--
-- Content, schedule and history have three different lifetimes, so they are
-- three tables: content is edited without touching the schedule (BR-10), the
-- schedule changes on every review, and history is append-only.

CREATE TABLE cards (
    id TEXT NOT NULL PRIMARY KEY,

    -- Only a deck whose content_type is 'card' may hold cards (BR-63).
    deck_id TEXT NOT NULL REFERENCES decks (id) ON DELETE CASCADE,

    front TEXT NOT NULL,
    back TEXT NOT NULL,

    -- `trim(front)` and `trim(back)` case-folded by Dart, written by the domain
    -- — the same shape `tags.name_folded` uses, and for the same reason
    -- (BR-93's comment there states it).
    --
    -- **Search compares these, never `lower(front)`.** SQLite's `lower()` folds
    -- ASCII only, so it leaves `Ô` and `Đ` alone. The search term was already
    -- folded in Dart with full Unicode, which made the two sides of the
    -- comparison disagree: a card stored as `CÔNG NGHỆ` could not be found by
    -- typing `công nghệ`, while a lowercase card could. Folding both sides in
    -- Dart makes the comparison byte-for-byte and correct for every alphabet.
    --
    -- Case only — no diacritic stripping. `công` does not match `cong`, exactly
    -- as `Động từ` and `Dong tu` stay two different tags. Diacritic-insensitive
    -- search is a product decision (S1), not a side effect of a bug fix.
    --
    -- `DEFAULT ''` because SQLite requires one to add a NOT NULL column; every
    -- write goes through the repository, which always supplies the real value.
    front_folded TEXT NOT NULL DEFAULT '',
    back_folded TEXT NOT NULL DEFAULT '',

    -- The user's own mark on the content (BR-92). It lives here rather than in
    -- card_study_states for the same reason `front` does: reset drops and
    -- recreates the schedule, and a flag has to survive that.
    is_flagged INTEGER NOT NULL DEFAULT 0 CHECK (is_flagged IN (0, 1)),

    -- Optional supporting text (BR-95). NULL, never empty string: nothing in
    -- the UI tells "never filled" from "filled then cleared", so allowing both
    -- would be two spellings of one state. The domain folds '' to NULL.
    example TEXT NULL,
    hint TEXT NULL,
    pronunciation TEXT NULL,

    -- NULL is a live card; anything else is a tombstone belonging to that
    -- deletion (BR-256, BR-258). Same contract as `decks.delete_batch_id` —
    -- see the long comment there for why exclusion is a column rather than an
    -- ancestor walk.
    --
    -- The card row surviving is the point: `card_study_states`,
    -- `study_answers` and `card_tags` all hang off `cards.id`, so leaving the
    -- row alone is what makes BR-262's "same ids, same history" true by
    -- construction rather than by a reconstruction that can be wrong.
    delete_batch_id TEXT NULL REFERENCES delete_batches (id) ON DELETE CASCADE,

    created_at DATETIME NOT NULL,
    updated_at DATETIME NOT NULL
);

-- Composite, and in exactly the order `cardsByDeck` filters and sorts:
-- `WHERE deck_id = ? ORDER BY created_at ASC, id ASC`.
--
-- Measured with `EXPLAIN QUERY PLAN` on 5,000 cards in one deck. A plain
-- `(deck_id)` index served the filter and left `USE TEMP B-TREE FOR ORDER BY`,
-- so SQLite read every matching row and sorted it before applying any `LIMIT`.
-- With the sort columns in the index the temp B-tree disappears and a page of 50
-- went from 1193us to 102us — the difference between sorting a deck to show the
-- top of it and seeking straight to the rows.
--
-- This is what makes the keyset pagination M4.11 owes (`WHERE deck_id = ? AND
-- (created_at, id) > (?, ?)`) a range scan rather than a full sort with a lid on
-- it.
--
-- It *replaces* `(deck_id)` rather than joining it: a composite index with the
-- same leading column answers every lookup the single-column one did, and
-- keeping both would make every insert maintain two B-trees for no gain.
CREATE INDEX idx_cards_deck_created ON cards (deck_id, created_at, id);

-- Same single reader as `idx_decks_delete_batch`: restore and purge selecting
-- one batch's rows.
CREATE INDEX idx_cards_delete_batch ON cards (delete_batch_id);

-- One row per card, created with the card (BR-09); dropped and recreated on
-- reset (BR-41).
--
-- No SRS column appears in `cards` and no `scheduler_generation` appears here
-- by accident: content survives every reset, the schedule does not.
CREATE TABLE card_study_states (
    -- Primary key because the relationship is 1–1.
    card_id TEXT NOT NULL PRIMARY KEY REFERENCES cards (id) ON DELETE CASCADE,

    -- Repeated from the root deck on purpose. The denormalisation is what turns
    -- two AD-09 invariants into something a query can check instead of
    -- something the code is trusted to maintain — invariant 9 is that query.
    scheduler_type TEXT NOT NULL CHECK (scheduler_type IN ('eight_box', 'sm2')),
    scheduler_version INTEGER NOT NULL,
    scheduler_generation INTEGER NOT NULL,

    -- NULL means the card has not finished the learning chain (BR-144). Set
    -- once, at the completion event, and back to NULL only by Reset (BR-152).
    --
    -- This column, not `answer_count`, is what "new" means (BR-90). The learning
    -- chain writes no `scheduled` answer at all, so a card can go through five
    -- stages and still read `answer_count = 0` — the definition it replaced
    -- would have called it new forever.
    learned_at DATETIME NULL,

    -- Shared by every scheduler. NULL and `learned_at` NULL travel together:
    -- no schedule until the chain completes, and never a schedule without one
    -- (BR-149, invariants 24 and 28).
    due_at DATETIME NULL,

    -- Updated by `scheduled` and by `relearning` alike (BR-20).
    last_answered_at DATETIME NULL,

    -- Counts `scheduled` reviews only (BR-20).
    answer_count INTEGER NOT NULL DEFAULT 0,
    lapse_count INTEGER NOT NULL DEFAULT 0,

    -- Per-scheduler columns, NULL when they do not apply. A JSON blob would be
    -- more flexible and would lose type safety and queryability — the two
    -- reasons AD-02 exists.
    current_box INTEGER NULL,
    ease_factor REAL NULL,
    interval_days INTEGER NULL,
    repetitions INTEGER NULL
);

CREATE INDEX idx_card_study_states_due ON card_study_states (due_at);
