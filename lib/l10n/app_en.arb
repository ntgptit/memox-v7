{
  "@@locale": "en",

  "appTitle": "MemoX",
  "@appTitle": {
    "description": "Application name. Shown as the MaterialApp title and in the Android task switcher. Not translated — it is a product name."
  },

  "navigationDecksLabel": "Decks",
  "@navigationDecksLabel": {
    "description": "Bottom navigation label for the Decks destination. Kept separate from decksTitle even though the English words match: a tab label is competing for width with another label and may need to be shortened in a language where the screen title cannot be."
  },

  "navigationReviewLabel": "Review",
  "@navigationReviewLabel": {
    "description": "Bottom navigation label for the Review destination, where the user studies due cards."
  },

  "reviewPlaceholderMessage": "MemoX is starting up.",
  "@reviewPlaceholderMessage": {
    "description": "Text on the temporary Review screen shown until the real review session screen lands (M5.4)."
  },

  "decksTitle": "Decks",
  "@decksTitle": {
    "description": "App bar title of the home screen, which lists the user's root decks. A deck is a folder of flashcards."
  },

  "decksLoadingLabel": "Loading decks",
  "@decksLoadingLabel": {
    "description": "Screen-reader label announced while the deck list is loading. A bare progress spinner announces nothing at all, so the user is told neither that something is happening nor when it stops."
  },

  "decksEmptyTitle": "No decks yet",
  "@decksEmptyTitle": {
    "description": "Heading of the empty state on the deck list, shown when the user has no root decks. Not an error — an account with no decks is a normal starting point."
  },

  "decksEmptyMessage": "Create a deck to start organizing your cards.",
  "@decksEmptyMessage": {
    "description": "Body of the deck list empty state. Explains what a deck is for; it carries no button because creating a deck is not built yet."
  },

  "decksLoadErrorTitle": "Couldn't load your decks",
  "@decksLoadErrorTitle": {
    "description": "Heading shown when reading the deck list from the local database fails. Carries no database detail — the user cannot act on it."
  },

  "decksLoadErrorMessage": "Please try again.",
  "@decksLoadErrorMessage": {
    "description": "Body of the deck list error state. Deliberately free of the exception, the SQL and the file path."
  },

  "retryAction": "Retry",
  "@retryAction": {
    "description": "Button that re-runs a failed read. On the deck list it re-subscribes to the database stream."
  },

  "startupErrorTitle": "MemoX could not start",
  "@startupErrorTitle": {
    "description": "Heading of the screen shown when bootstrap fails before the app can render. Must not contain technical detail."
  },

  "startupErrorMessage": "Something went wrong while starting the app. Please close it and open it again.",
  "@startupErrorMessage": {
    "description": "Body of the startup failure screen. Tells the user what to do; deliberately carries no stack trace, URL or error code."
  },

  "unexpectedErrorTitle": "Something went wrong",
  "@unexpectedErrorTitle": {
    "description": "Heading shown in place of Flutter's red error screen when a widget fails to build."
  },

  "unexpectedErrorMessage": "This part of the app could not be displayed.",
  "@unexpectedErrorMessage": {
    "description": "Body shown in place of Flutter's red error screen. Deliberately carries no stack trace or widget name."
  },
  "pageNotFoundTitle": "Page not found",
  "@pageNotFoundTitle": {
    "description": "Heading of the screen shown when a location matches no route. Carries no URL — the user cannot act on it, and a location can hold private content once deep links exist."
  },

  "pageNotFoundMessage": "The page you requested does not exist.",
  "@pageNotFoundMessage": {
    "description": "Body of the 404 screen. Deliberately free of the failed path, the router state and any technical detail."
  },

  "goHomeAction": "Go home",
  "@goHomeAction": {
    "description": "Button on the 404 screen that returns to the app's main route."
  }
}
