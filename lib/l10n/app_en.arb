{
  "@@locale": "en",
  "appTitle": "MemoX",
  "@appTitle": {
    "description": "Application name. Shown as the MaterialApp title and in the Android task switcher. Not translated — it is a product name."
  },
  "navigationDecksLabel": "Library",
  "@navigationDecksLabel": {
    "description": "Bottom navigation label for the Decks branch. \"Library\" rather than \"Decks\": the tab is the whole content library — the deck tree, the cards inside it, and the starter-library flow — while \"Decks\" named only its top level. The screen title (decksTitle) says the same word, synced by owner decision 2026-08-12 — the tab and its screen must read as one place."
  },
  "navigationStudyLabel": "Study",
  "@navigationStudyLabel": {
    "description": "Bottom navigation label for the Study destination, covering both learning new cards and reviewing due ones. Kept separate from a screen title for the same reason as decksTitle: a tab label competes for width and may need shortening where a title does not."
  },
  "navigationProgressLabel": "Progress",
  "@navigationProgressLabel": {
    "description": "Bottom navigation label for the Progress destination. The branch shows a placeholder until the statistics feature exists (AD-19); the label names the destination, not the placeholder."
  },
  "navigationSettingsLabel": "Settings",
  "@navigationSettingsLabel": {
    "description": "Bottom navigation label for the Settings destination. The branch shows a placeholder until app settings exist (AD-19)."
  },
  "progressTitle": "Progress",
  "@progressTitle": {
    "description": "App bar title of the Progress branch. Kept separate from navigationProgressLabel for the same reason as decksTitle: a tab label competes for width, a title does not."
  },
  "progressLoadingLabel": "Loading your progress",
  "@progressLoadingLabel": {
    "description": "Screen-reader label announced while the Progress screen is loading. A bare spinner announces nothing at all."
  },
  "progressStreakSectionLabel": "Current streak",
  "@progressStreakSectionLabel": {
    "description": "Heading of the hero section (W2). Deliberately 'current', not 'longest': longest streak has no business rule behind it and is out of scope for v1 (BR-227)."
  },
  "progressStreakDaysLabel": "{count, plural, =0{0 days} =1{1 day} other{{count} days}}",
  "@progressStreakDaysLabel": {
    "placeholders": {
      "count": {
        "type": "int"
      }
    },
    "description": "The hero headline: how many consecutive local days have activity (BR-197). The unit is always spelled out -- a bare numeral at display size reads as a count of something the user has to guess at."
  },
  "progressStreakTodayLine": "{count, plural, =0{No cards today} =1{1 card today} other{{count} cards today}}",
  "@progressStreakTodayLine": {
    "placeholders": {
      "count": {
        "type": "int"
      }
    },
    "description": "The line under the hero headline when the streak includes today. 'Cards' is the unit on purpose: the count is distinct cards touched today, not answers given (BR-228)."
  },
  "progressStreakHeldLine": "No cards today — your streak is held from yesterday",
  "@progressStreakHeldLine": {
    "description": "The hero's supporting line when today has no activity but yesterday does (BR-197, A1). Without it a headline of '7 days' beside a Today section of zero reads as a contradiction."
  },
  "progressStreakZeroLine": "Study today to start a streak",
  "@progressStreakZeroLine": {
    "description": "The hero's supporting line when the streak is zero (P6). An invitation, never a reproach: the person reading it has just come back."
  },
  "progressStreakSemanticsHeadline": "{streak, plural, =0{Current streak, 0 days} =1{Current streak, 1 day} other{Current streak, {streak} days}}",
  "@progressStreakSemanticsHeadline": {
    "placeholders": {
      "streak": {
        "type": "int"
      }
    },
    "description": "The first clause of the hero's announcement (W6.4). Read as separate nodes, the number and its unit arrive apart and the figure loses its meaning — so the headline is one clause. The second clause is the hero's visible supporting line, joined on by `progressStreakSemantics`, which owns the punctuation: a label built from counts alone drops the held-from-yesterday sentence that W2.5 exists to say."
  },
  "progressStreakSemantics": "{headline}. {support}",
  "@progressStreakSemantics": {
    "placeholders": {
      "headline": {
        "type": "String"
      },
      "support": {
        "type": "String"
      }
    },
    "description": "The hero announcement, one clause then the sentence the screen shows. Separate from the two halves because the separator is punctuation a screen reader pauses on, and punctuation is not the same in every language."
  },
  "progressTodaySectionLabel": "Today",
  "@progressTodaySectionLabel": {
    "description": "Heading of the Today section (W3)."
  },
  "progressTodayCardsLabel": "{count, plural, =0{No cards} =1{1 card} other{{count} cards}}",
  "@progressTodayCardsLabel": {
    "placeholders": {
      "count": {
        "type": "int"
      }
    },
    "description": "The Today total. The unit is mandatory: the count is distinct cards, and a user shown a bare number would reasonably read it as turns taken (BR-228)."
  },
  "progressTodayLearningLabel": "Learning",
  "@progressTodayLearningLabel": {
    "description": "Half of the Today breakdown: cards with at least one learning answer today (BR-195). Same word the learning session uses, so the two agree."
  },
  "progressTodayReviewingLabel": "Reviewing",
  "@progressTodayReviewingLabel": {
    "description": "The other half: cards whose answers today were scheduled or relearning only (BR-195)."
  },
  "progressTodayPartitionNote": "Learning and Reviewing add up to today's total — a card counts once, whichever way you met it.",
  "@progressTodayPartitionNote": {
    "description": "One line explaining that the two halves are a partition (BR-195). Not decoration: without it a user who answered the same card in both modes expects the halves to sum to more than the total."
  },
  "progressWeekSectionLabel": "Daily activity",
  "@progressWeekSectionLabel": {
    "description": "Heading of the activity chart (W4). Names what the chart is rather than its window: the chart is always seven days including today (BR-196) while the range selector below it switches 7/30, and both headings reading 'Last 7 days' contradicted each other the moment 30 was picked (X9)."
  },
  "progressWeekTodayLabel": "Today",
  "@progressWeekTodayLabel": {
    "description": "Row label of the last row of the chart. 'Today' rather than the weekday name, so the row that matters most is not something the reader has to work out from the date."
  },
  "progressWeekdayShortLabel": "{weekday, select, 1{Mon} 2{Tue} 3{Wed} 4{Thu} 5{Fri} 6{Sat} 7{Sun} other{}}",
  "@progressWeekdayShortLabel": {
    "placeholders": {
      "weekday": {
        "type": "String"
      }
    },
    "description": "Row labels of the chart, keyed by Dart's DateTime.weekday (1 = Monday). Spelled out in ARB rather than taken from intl's DateFormat.E, which needs locale data initialised at startup for anything but English -- a bootstrap step and a test-flakiness source bought for seven words."
  },
  "progressWeekDaySemantics": "{day}: {count, plural, =0{no cards} =1{1 card} other{{count} cards}}",
  "@progressWeekDaySemantics": {
    "placeholders": {
      "day": {
        "type": "String"
      },
      "count": {
        "type": "int"
      }
    },
    "description": "What a screen reader announces for one row of the chart (W6.4). The bar and its track are decoration and are excluded from semantics, so this sentence is the whole of the row for a reader."
  },
  "progressEmptyTitle": "No study activity yet",
  "@progressEmptyTitle": {
    "description": "Heading of the lifetime-empty face (A2, P7). It replaces the whole screen rather than showing three sections of zeros, which read as a failed load."
  },
  "progressEmptyMessage": "Answer your first card and your streak starts today.",
  "@progressEmptyMessage": {
    "description": "Body of the lifetime-empty face. Says what will make the screen fill up, rather than restating that it is empty."
  },
  "progressEmptyAction": "Start studying",
  "@progressEmptyAction": {
    "description": "The call to action on the lifetime-empty face. It navigates to the Study branch for real (P7) -- a button that only says 'not yet' is a button that lies."
  },
  "progressErrorTitle": "Couldn't load your progress",
  "@progressErrorTitle": {
    "description": "Heading of the error face (E1). Names what failed, so it is not confused with a study session failing."
  },
  "progressErrorMessage": "Your study history is safe. Try again in a moment.",
  "@progressErrorMessage": {
    "description": "Body of the error face. Carries the fact the user actually worries about -- history is append-only and a failed read changes nothing -- and never the failure's own message, which can name a table (BR-52)."
  },
  "progressErrorRetryAction": "Try again",
  "@progressErrorRetryAction": {
    "description": "Retry on the error face. Re-opens the read; it never writes (BR-226)."
  },
  "settingsTitle": "Settings",
  "@settingsTitle": {
    "description": "App bar title of the Settings branch. Kept separate from navigationSettingsLabel for the same reason as decksTitle: a tab label competes for width, a title does not."
  },
  "settingsLoadingLabel": "Loading settings",
  "@settingsLoadingLabel": {
    "description": "Screen-reader label announced while the settings row is read. A bare spinner announces neither that something is happening nor when it stops."
  },
  "settingsLoadErrorTitle": "Couldn't load your settings",
  "@settingsLoadErrorTitle": {
    "description": "Whole-screen error when the settings stream fails (UC-17 E3). No control renders a value in this state — an invented default would be indistinguishable from a stored one."
  },
  "settingsSaveErrorTitle": "Couldn’t save",
  "@settingsSaveErrorTitle": {
    "description": "Title of the in-section error band when a settings write fails (UC-17 E2, BR-224). The body comes from the failure type through mxWriteFailure."
  },
  "settingsStudyDefaultsSection": "Study defaults",
  "@settingsStudyDefaultsSection": {
    "description": "Heading of the group holding the app-wide card limit and new-card order (BR-219). Plural 'defaults' on purpose: these are what a deck uses when it has chosen nothing of its own."
  },
  "settingsStudyDefaultsNote": "Applies to sessions you start after saving. A session already running keeps its own limit.",
  "@settingsStudyDefaultsNote": {
    "description": "States BR-221 on the global screen. Longer than studyOptionsNextSessionNote, which sits on a deck's own options screen: there the user is one tap from the session, here they may have one running in another tab."
  },
  "settingsAppearanceSection": "Appearance",
  "@settingsAppearanceSection": {
    "description": "Heading of the theme group (BR-222)."
  },
  "settingsThemeSystem": "System",
  "@settingsThemeSystem": {
    "description": "Theme choice: follow the platform's brightness and keep following it (BR-214). Separate from settingsLanguageSystem even though English spells them the same — a translator may need different words for a theme and a language."
  },
  "settingsThemeLight": "Light",
  "@settingsThemeLight": {
    "description": "Theme choice: always light, whatever the platform says (BR-214)."
  },
  "settingsThemeDark": "Dark",
  "@settingsThemeDark": {
    "description": "Theme choice: always dark, whatever the platform says (BR-214)."
  },
  "settingsLanguageSection": "Language",
  "@settingsLanguageSection": {
    "description": "Heading of the language group (BR-223)."
  },
  "settingsLanguageSystem": "System",
  "@settingsLanguageSystem": {
    "description": "Language choice: resolve from the platform's preferred locales, falling back to English (BR-215)."
  },
  "settingsLanguageEnglish": "English",
  "@settingsLanguageEnglish": {
    "description": "Language choice. An endonym, and it stays 'English' in every translation: somebody stuck in a language they cannot read has to be able to find the name of their own."
  },
  "settingsLanguageVietnamese": "Tiếng Việt",
  "@settingsLanguageVietnamese": {
    "description": "Language choice. An endonym, unchanged in every translation for the same reason as settingsLanguageEnglish."
  },
  "settingsResetAction": "Reset to defaults",
  "@settingsResetAction": {
    "description": "Puts every app option back to its default (BR-225). Deliberately worded away from 'Reset learning progress' (BR-42), which is a different action with different consequences."
  },
  "settingsResetDescription": "Puts app options back to their defaults. Your decks and learning progress are not affected.",
  "@settingsResetDescription": {
    "description": "Shown under the reset action at rest, not only inside the confirmation. Two actions in this app start with 'Reset', and the scope is the only thing that tells them apart (BR-225)."
  },
  "settingsResetConfirmTitle": "Reset app options?",
  "@settingsResetConfirmTitle": {
    "description": "Title of the reset confirmation sheet (UC-17 A3)."
  },
  "settingsResetConfirmAction": "Reset",
  "@settingsResetConfirmAction": {
    "description": "Confirms the reset. Short because the sheet's title and body already carry the scope."
  },
  "settingsSavingLabel": "Saving",
  "@settingsSavingLabel": {
    "description": "Announced while a settings group is being written (BR-224, wireframe W6). A group that only greys out reports its state by colour alone."
  },
  "studyOptionsUseAppDefaults": "Use app defaults",
  "@studyOptionsUseAppDefaults": {
    "description": "Clears this root deck's study-options override so it follows the app-wide defaults again (BR-220). Only shown when an override exists — there is nothing to clear otherwise."
  },
  "studyOptionsOverrideNote": "This deck uses its own values instead of the app defaults.",
  "@studyOptionsOverrideNote": {
    "description": "Shown on a deck whose root carries an override (BR-220), so the user knows why changing the app defaults did not change this deck."
  },
  "decksTitle": "Library",
  "@decksTitle": {
    "description": "App bar title of the home screen, synced with navigationDecksLabel (owner decision, 2026-08-12): the tab and the screen it lands on say the same word, because a tab called Library opening a screen called Decks read as two places."
  },
  "decksLoadingLabel": "Loading decks",
  "@decksLoadingLabel": {
    "description": "Screen-reader label announced while the deck list is loading. A bare progress spinner announces nothing at all, so the user is told neither that something is happening nor when it stops."
  },
  "decksEmptyTitle": "No decks yet",
  "@decksEmptyTitle": {
    "description": "Heading of the empty state on the deck list, shown when the user has no root decks. Not an error — an account with no decks is a normal starting point."
  },
  "decksEmptyMessage": "Create a deck to start organizing your cards.",
  "@decksEmptyMessage": {
    "description": "Body of the deck list empty state. Explains what a deck is for; it carries no button because creating a deck is not built yet."
  },
  "decksLoadErrorTitle": "Couldn't load your decks",
  "@decksLoadErrorTitle": {
    "description": "Heading shown when reading the deck list from the local database fails. Carries no database detail — the user cannot act on it."
  },
  "decksLoadErrorMessage": "Please try again.",
  "@decksLoadErrorMessage": {
    "description": "Body of the deck list error state. Deliberately free of the exception, the SQL and the file path."
  },
  "retryAction": "Retry",
  "@retryAction": {
    "description": "The app-wide retry label, on every surface that offers recovery from a failed operation — a read that did not land, a write that was refused, a platform call that was rejected. Deliberately generic and shared across the app rather than owned by any one screen: some callers retry a stream subscription, others re-send a write, and the daily-reminder band re-runs whichever of enable, disable or change-time failed. A label naming one of those would be wrong on the rest, which is why this description names no count and no list — an earlier version said \"three surfaces\" while there were nine, and a wrong count is an invitation to specialise the label after checking only some of them."
  },
  "deckCreateRootAction": "New deck",
  "@deckCreateRootAction": {
    "description": "Primary action on the deck list that opens the form for creating a new top-level deck."
  },
  "deckCardCountLabel": "{count, plural, =0{No cards} =1{1 card} other{{count} cards}}",
  "@deckCardCountLabel": {
    "placeholders": {
      "count": {
        "type": "int"
      }
    },
    "description": "Total number of cards in a deck's whole tree, shown on each row of the deck list."
  },
  "deckDueCountLabel": "{count, plural, other{{count} due}}",
  "@deckDueCountLabel": {
