  "studyMatchWrong": "Không phải một cặp",
  "@studyMatchWrong": {
    "description": "Announced for the two match tiles of a pairing that was wrong, for as long as they are red."
  },
  "studyMatchPaired": "Đã ghép",
  "@studyMatchPaired": {
    "description": "Announced for a match tile that has been paired correctly. The tick beside it is decoration; this is what a screen reader reads, because a pair marked only in green is not marked for everyone."
  },
  "studyGuessOverline": "Đây là gì?",
  "@studyGuessOverline": {
    "description": "The small uppercase line above the term on a guess prompt card."
  },
  "studyGuessCorrectAnswer": "Đáp án đúng",
  "@studyGuessCorrectAnswer": {
    "description": "Announced for the right option once a guess question has been answered. The green tick beside it marks it for people who can see it; this marks it for everyone."
  },
  "studyGuessYourAnswer": "Bạn chọn, sai",
  "@studyGuessYourAnswer": {
    "description": "Announced for the option the learner picked when it was wrong. Red and a cross carry it visually (BR-126: the first choice is the only one)."
  },
  "studyHintRecallAnswered": "Đáp án đang hiện",
  "@studyHintRecallAnswered": {
    "description": "Bottom hint line for recall once the back is uncovered — by the learner pressing Show answer, or by the clock. The mode's usual hint asks them to recall it first, which is a line about a screen that has moved on."
  },
  "studyRecallCountedForgotten": "tính là đã quên. Vòng sau bắt đầu lại đủ hai mươi giây.",
  "@studyRecallCountedForgotten": {
    "description": "Second half of the line shown once a recall timeout has been written, after studyRecallTimedOut. BR-130: running out is wrong and cannot be turned back into a right answer, so the screen says which it was rather than leaving the learner to infer it from a card that moved on."
  },
  "studyRecallTimedOutUnsaved": "Hết giờ, và kết quả này chưa lưu được. Hãy thử lại.",
  "@studyRecallTimedOutUnsaved": {
    "description": "Shown when the timeout write was refused. The outcome stays wrong (BR-130) — the only thing on offer is the same answer again, never the choice the clock already took away."
  },
  "studyRecallAnswerHidden": "Đáp án đang ẩn",
  "@studyRecallAnswerHidden": {
    "description": "Label of the covered answer area on a recall turn, before it is revealed. The area is a blank panel; without a label a screen reader finds nothing there at all."
  },
  "studyFillAnswerLabel": "Đáp án",
  "@studyFillAnswerLabel": {
    "description": "Heading over the card's own front — the Korean term — shown on the answer card after a fill turn is graded wrong (BR-134). A correct turn does not get it: spelling the answer back to somebody who just typed it reads as a correction."
  },
  "deckConflictResetNeedsRoot": "Tiến độ học được đặt lại ở deck gốc.",
  "@deckConflictResetNeedsRoot": {
    "description": "Refusal shown when a reset is attempted below the root. The study mode and the generation belong to the root (BR-05), so there is no such operation one level down (UC-07 A4)."
  },
  "deckConflictResetSchedulerUnknown": "Phiên bản ứng dụng này không biết chế độ học đó.",
  "@deckConflictResetSchedulerUnknown": {
    "description": "Refusal shown when a reset would write a scheduler this build does not recognise. Reachable only from data written by a newer version."
  },
  "deckConflictSchedulerNeedsRoot": "Chế độ ôn tập được đặt ở deck cấp cao nhất.",
  "@deckConflictSchedulerNeedsRoot": {
    "description": "Refusal shown when a study-mode change is attempted below the root. The scheduler lives on the root and a sub-deck's columns stay NULL (BR-05, BR-06)."
  },
  "deckConflictSchedulerLocked": "Bạn đã học deck này rồi nên chế độ ôn tập bị khoá. Đặt lại tiến độ học để đổi.",
  "@deckConflictSchedulerLocked": {
    "description": "Refusal shown when a study-mode change lands after a card has finished the learning chain (BR-13). Reset learning progress is the only way through (BR-44)."
  },
  "deckSchedulerChangeAction": "Đổi chế độ ôn tập",
  "@deckSchedulerChangeAction": {
    "description": "Opens the study-mode picker on a root deck (UC-03). Present whether or not the mode is locked — hiding it makes users think the feature does not exist (UC-03 A1)."
  },
  "deckSchedulerChangeTitle": "Chế độ ôn tập",
  "@deckSchedulerChangeTitle": {
    "description": "Title of the sheet that changes a root deck's study mode (UC-03)."
  },
  "deckSchedulerChangeBody": "Mọi thẻ trong deck này và các deck con sẽ bắt đầu lại lịch học theo chế độ bạn chọn. Không có nội dung nào bị đụng tới — thẻ, tag và ghi chú đều giữ nguyên.",
  "@deckSchedulerChangeBody": {
    "description": "Explains what an unlocked study-mode change does (BR-14). Deliberately not the destructive language of Reset learning progress: no history and no generation is being discarded (UC-03)."
  },
  "deckSchedulerChangeSessionNotice": "Phiên học đang mở của bạn sẽ được đóng lại.",
  "@deckSchedulerChangeSessionNotice": {
    "description": "Shown in the study-mode change sheet. The open session's queue was dealt for the old algorithm, so it is invalidated inside the same transaction rather than left to fail later (BR-83)."
  },
  "deckSchedulerChangeConfirm": "Đổi chế độ ôn tập",
  "@deckSchedulerChangeConfirm": {
    "description": "Confirms an unlocked study-mode change (UC-03). A primary action, not a destructive one."
  },
  "deckSchedulerLockedTitle": "Chế độ ôn tập đang khoá",
  "@deckSchedulerLockedTitle": {
    "description": "Title of the study-mode sheet on a root deck that has been studied (BR-13, UC-03 A1)."
  },
  "deckSchedulerLockedBody": "Deck này đã có thẻ bạn học xong nên chế độ ôn tập được cố định. Đặt lại tiến độ học sẽ mở khoá và cho mọi thẻ bắt đầu lại.",
  "@deckSchedulerLockedBody": {
    "description": "Explains the lock and points at the only way through it (BR-13, BR-44, UC-03 A1)."
  },
  "deckResetProgressAction": "Đặt lại tiến độ học",
  "@deckResetProgressAction": {
    "description": "The action on a root deck that clears every card's schedule so the tree can be learned again - and the only way to change a study mode after the first card has been learned (BR-13, BR-44, UC-07)."
  },
  "deckResetProgressTitle": "Đặt lại tiến độ học?",
  "@deckResetProgressTitle": {
    "description": "Heading of the confirmation. BR-50 requires it to state both what is kept and what is lost."
  },
  "deckResetProgressKeptTitle": "Giữ nguyên",
  "@deckResetProgressKeptTitle": {
    "description": "Heading of the first of BR-50's two lists."
  },
  "deckResetProgressKeptBody": "Toàn bộ deck, deck con, thẻ, tag và ghi chú — cùng lịch sử ôn tập cũ để tham khảo.",
  "@deckResetProgressKeptBody": {
    "description": "What a reset leaves alone (BR-41, BR-43). The history is named explicitly because losing it is what people fear about a reset."
  },
  "deckResetProgressLostTitle": "Mất",
  "@deckResetProgressLostTitle": {
    "description": "Heading of the second of BR-50's two lists."
  },
  "deckResetProgressLostBody": "Lịch ôn, ngày đến hạn và tiến độ của mọi thẻ — cùng mọi phiên đang dở. Tất cả thẻ trở lại tập Học mới và học lại từ đầu.",
  "@deckResetProgressLostBody": {
    "description": "What a reset destroys (BR-42, BR-152, BR-83). The last sentence is the consequence people miss: cards do not merely become due, they walk the whole learning chain again (BR-142)."
  },
  "deckResetProgressSchedulerLabel": "Chế độ học sau khi đặt lại",
  "@deckResetProgressSchedulerLabel": {
    "description": "Label of the scheduler picker inside the confirmation. Changing it is the main purpose of the operation (UC-07 step 3), and the reset is the only mechanism that unlocks it (BR-44)."
  },
  "deckResetProgressNothingToLose": "Deck này chưa học thẻ nào, nên không có tiến độ nào để mất.",
  "@deckResetProgressNothingToLose": {
    "description": "Shown instead of the Lost list when the deck has no learned cards (UC-07 A2). The operation is still allowed - it is how the study mode is changed."
  },
  "deckResetProgressConfirm": "Đặt lại",
  "@deckResetProgressConfirm": {
    "description": "Confirms the reset. Destructive, so it carries the danger styling."
  },
