{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/navigation/**",
              "ui_kits/memox-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|Inter))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxActionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|variant|isLoading|icon|isDisabled|isBlock|isCompact|autoFocus|key|ref|className|style|children)$/]",
        "message": "<MxActionButton> doesn't accept that prop. Declared props: label, onClick, variant, isLoading, icon, isDisabled, isBlock, isCompact, autoFocus."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxActionButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|destructive)$/]",
        "message": "<MxActionButton> variant must be one of 'primary' | 'secondary' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxActionSheetAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onPress|icon|variant|isEnabled|key|ref|className|style|children)$/]",
        "message": "<MxActionSheetAction> doesn't accept that prop. Declared props: label, onPress, icon, variant, isEnabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxActionSheetAction'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:normal|destructive)$/]",
        "message": "<MxActionSheetAction> variant must be one of 'normal' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxAsyncView'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|value|error|loadingLabel|data|renderError|loadingFrame|key|ref|className|style|children)$/]",
        "message": "<MxAsyncView> doesn't accept that prop. Declared props: status, value, error, loadingLabel, data, renderError, loadingFrame."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxAsyncView'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:loading|error|data)$/]",
        "message": "<MxAsyncView> status must be one of 'loading' | 'error' | 'data'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxBreadcrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onTap|key|ref|className|style|children)$/]",
        "message": "<MxBreadcrumbItem> doesn't accept that prop. Declared props: label, onTap."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|elevation|onClick|actionLabel|padding|className|style|key|ref|className|style|children)$/]",
        "message": "<MxCard> doesn't accept that prop. Declared props: children, elevation, onClick, actionLabel, padding, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxCard'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:none|flat|card|raised|overlay)$/]",
        "message": "<MxCard> elevation must be one of 'none' | 'flat' | 'card' | 'raised' | 'overlay'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|message|confirmLabel|cancelLabel|onConfirm|onCancel|variant|isSubmitting|key|ref|className|style|children)$/]",
        "message": "<MxConfirmDialog> doesn't accept that prop. Declared props: title, message, confirmLabel, cancelLabel, onConfirm, onCancel, variant, isSubmitting."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxConfirmDialog'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:normal|destructive)$/]",
        "message": "<MxConfirmDialog> variant must be one of 'normal' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxContentShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|leading|actions|subheader|children|padding|isScrollable|fab|isCompact|style|key|ref|className|style|children)$/]",
        "message": "<MxContentShell> doesn't accept that prop. Declared props: title, leading, actions, subheader, children, padding, isScrollable, fab, isCompact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxEmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|message|icon|actionLabel|onAction|key|ref|className|style|children)$/]",
        "message": "<MxEmptyState> doesn't accept that prop. Declared props: title, message, icon, actionLabel, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxErrorState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|message|retryLabel|onRetry|key|ref|className|style|children)$/]",
        "message": "<MxErrorState> doesn't accept that prop. Declared props: title, message, retryLabel, onRetry."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|filled|size|color|className|style|key|ref|className|style|children)$/]",
        "message": "<MxIcon> doesn't accept that prop. Declared props: name, filled, size, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxIconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|semanticLabel|onClick|filled|tooltip|isDisabled|key|ref|className|style|children)$/]",
        "message": "<MxIconButton> doesn't accept that prop. Declared props: icon, semanticLabel, onClick, filled, tooltip, isDisabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxListTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|leading|trailing|onClick|isEnabled|isSelected|key|ref|className|style|children)$/]",
        "message": "<MxListTile> doesn't accept that prop. Declared props: title, subtitle, leading, trailing, onClick, isEnabled, isSelected."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxLoadingState'] > JSXAttribute > JSXIdentifier[name!=/^(?:semanticsLabel|key|ref|className|style|children)$/]",
        "message": "<MxLoadingState> doesn't accept that prop. Declared props: semanticsLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxNavigationDestination'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|selectedIcon|label|key|ref|className|style|children)$/]",
        "message": "<MxNavigationDestination> doesn't accept that prop. Declared props: icon, selectedIcon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxPillButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|isSelected|onClick|icon|semanticLabel|key|ref|className|style|children)$/]",
        "message": "<MxPillButton> doesn't accept that prop. Declared props: label, isSelected, onClick, icon, semanticLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|valueLabel|size|shape|tone|key|ref|className|style|children)$/]",
        "message": "<MxProgressBar> doesn't accept that prop. Declared props: value, label, valueLabel, size, shape, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxProgressBar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<MxProgressBar> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxProgressBar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|flush)$/]",
        "message": "<MxProgressBar> shape must be one of 'pill' | 'flush'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:progress|streak)$/]",
        "message": "<MxProgressBar> tone must be one of 'progress' | 'streak'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxSearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|resultCount|autoFocus|key|ref|className|style|children)$/]",
        "message": "<MxSearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, resultCount, autoFocus."
      },
      {
        "selector": "JSXOpeningElement[name.name='MxTextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|hintText|helperText|errorText|isEnabled|isReadOnly|maxLength|maxLines|type|onSurface|autoFocus|key|ref|className|style|children)$/]",
        "message": "<MxTextField> doesn't accept that prop. Declared props: label, value, onChange, hintText, helperText, errorText, isEnabled, isReadOnly, maxLength, maxLines, type, onSurface, autoFocus."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
