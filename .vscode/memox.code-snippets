{
  "//": [
    "Snippets for the shapes that repeat once per feature in this repo.",
    "Derived from features/deck — see",
    ".claude/skills/flutter-feature-slice/assets/feature_blueprint.md.",
    "",
    "They are deliberately opinionated: each one already carries the guard-safe",
    "file suffix, the retry policy on local reads, the ref.mounted check after the",
    "await, and the double-submit guard. Those are the four things that are easy to",
    "leave out and expensive to notice missing."
  ],
  "memox: repository contract (domain)": {
    "prefix": "mxrepo",
    "scope": "dart",
    "description": "Abstract repository interface. Goes in domain/<name>_repository.dart — domain imports no Flutter, Drift or Riverpod.",
    "body": [
      "import '${1:name}_entity.dart';",
      "",
      "/// Contract for ${2:what this owns} (UC-${3:xx}).",
      "///",
      "/// Written from what presentation needs, not from the table (AD-01): no method",
      "/// accepts or returns a Drift row, and no Drift exception escapes an",
      "/// implementation — failures surface as the domain `Failure` hierarchy.",
      "///",
      "/// Reads are `watch()` streams (AD-01); mutations are futures.",
      "abstract interface class ${4:Name}Repository {",
      "  Stream<List<${5:Name}Entity>> watch${6:Things}();",
      "",
      "  Future<${5:Name}Entity> get${7:Thing}ById(String id);",
      "",
      "  $0",
      "}"
    ]
  },
  "memox: repository provider (composition root)": {
    "prefix": "mxrepoprov",
    "scope": "dart",
    "description": "Wires the concrete impl. Goes in lib/app/di/ — presentation may not import data/, domain may not import Riverpod, core may not import a feature.",
    "body": [
      "import 'package:riverpod_annotation/riverpod_annotation.dart';",
      "",
      "import '../../core/database/app_database_provider.dart';",
      "import '../../features/${1:feature}/data/${1:feature}_repository_impl.dart';",
      "import '../../features/${1:feature}/data/local/${1:feature}_dao.dart';",
      "import '../../features/${1:feature}/domain/${1:feature}_repository.dart';",
      "",
      "part '${1:feature}_repository_provider.g.dart';",
      "",
      "/// Where the concrete implementation is chosen, and the only place it is named",
      "/// outside its own layer. The return type is the domain contract, so nothing",
      "/// above can tell Drift is behind it (AD-01).",
      "@Riverpod(keepAlive: true)",
      "${2:Name}Repository ${1:feature}Repository(Ref ref) =>",
      "    ${2:Name}RepositoryImpl(${2:Name}Dao(ref.watch(appDatabaseProvider)));$0"
    ]
  },
  "memox: read controller (stream)": {
    "prefix": "mxread",
    "scope": "dart",
    "description": "Stream read provider with retry disabled. Goes in presentation/<name>_controller.dart — a *_provider.dart here would trip widget_no_repository_access.",
    "body": [
      "import 'package:riverpod_annotation/riverpod_annotation.dart';",
      "",
      "import '../../../app/di/${1:feature}_repository_provider.dart';",
      "import '../../../core/state/retry_policy.dart';",
      "import '../domain/${1:feature}_entity.dart';",
      "",
      "part '${2:name}_controller.g.dart';",
      "",
      "/// ${3:What this reads} (UC-${4:xx}).",
      "///",
      "/// Automatic retry is off — while Riverpod retries, the state is",
      "/// `AsyncLoading`, so a failed local read would spin for ~13s instead of",
      "/// showing its error state. Retry is the button on that state, which",
      "/// invalidates this provider and opens a fresh `watch()`.",
      "@Riverpod(retry: noAutomaticRetry)",
      "Stream<List<${5:Name}Entity>> ${6:things}(Ref ref) =>",
      "    ref.watch(${1:feature}RepositoryProvider).watch${7:Things}();$0"
    ]
  },
  "memox: write controller (submit state machine)": {
    "prefix": "mxwrite",
    "scope": "dart",
    "description": "One controller per mutation, with the five steps: double-submit guard, local validation, submitting, ref.mounted after await, failure mapping.",
    "body": [
      "/// ${1:What this writes} (UC-${2:xx}).",
      "@riverpod",
      "class ${3:Verb}${4:Thing}Controller extends _\\$${3:Verb}${4:Thing}Controller {",
      "  @override",
      "  ${5:Feature}SubmitState build(${6:String id}) => const ${5:Feature}SubmitState();",
      "",
      "  Future<void> submit({required ${7:String value}}) async {",
      "    // 1. Refuse a second submit while the first is in flight: without this a",
      "    //    double tap writes twice and the user sees one result.",
      "    if (!state.canSubmit) return;",
      "",
      "    // 2. Validate against the domain rule locally, so an invalid value is an",
      "    //    inline error rather than a round trip.",
      "    final problem = ${8:Name}Entity.${9:valueProblem}(${10:value});",
      "    if (problem != null) {",
      "      state = ${5:Feature}SubmitState(${11:problem}: problem);",
      "",
      "      return;",
      "    }",
      "",
      "    // 3. Submitting. Nothing clears the user's input — the widget owns it.",
      "    state = const ${5:Feature}SubmitState(isSubmitting: true);",
      "    try {",
      "      await ref.read(${12:feature}RepositoryProvider).${13:doIt}();",
      "      // 4. The sheet can be dismissed mid-write; writing state into a disposed",
      "      //    controller is a crash.",
      "      if (!ref.mounted) return;",
      "      // 5. The widget reacts to this via `ref.listen` on the transition.",
      "      state = const ${5:Feature}SubmitState(isDone: true);",
      "    } on Failure catch (failure) {",
      "      if (!ref.mounted) return;",
      "      state = ${14:featureSubmitFailure}(failure, ${15:value: value});",
      "    }",
      "  }",
      "",
      "  /// Clears the last attempt so a reopened form starts clean. Called from the",
      "  /// tap that opens the form, never from a widget life-cycle.",
      "  void reset() => state = const ${5:Feature}SubmitState();",
      "}$0"
    ]
  },
  "memox: screen (composition only)": {
    "prefix": "mxscreen",
    "scope": "dart",
    "description": "Screen scaffolding: MxContentShell + Consumer + MxAsyncView. Plain widget wrapping Consumer, not ConsumerWidget.",
    "body": [
      "import 'package:flutter/material.dart';",
      "import 'package:flutter_riverpod/flutter_riverpod.dart';",
      "",
      "import '../../../l10n/l10n_extension.dart';",
      "import '../../../shared/widgets/mx_async_view.dart';",
      "import '../../../shared/widgets/mx_content_shell.dart';",
      "import '../../../shared/widgets/mx_empty_state.dart';",
      "import '../../../shared/widgets/mx_error_state.dart';",
      "import '${1:name}_controller.dart';",
      "",
      "/// ${2:What the user does here} (UC-${3:xx}).",
      "///",
      "/// Composition only: it picks copy and hands each case to a shared component.",
      "/// No query, no business rule, nothing computed in `build`.",
      "///",
      "/// A plain widget wrapping `Consumer` rather than a `ConsumerWidget`: only the",
      "/// body depends on the provider, and the two-argument `build` signature trips",
      "/// the project guard's `no_generated_ref_subclass` rule.",
      "class ${4:Name}Screen extends StatelessWidget {",
      "  const ${4:Name}Screen({super.key});",
      "",
      "  @override",
      "  Widget build(BuildContext context) {",
      "    return MxContentShell(",
      "      title: context.l10n.${5:titleKey},",
      "      body: Consumer(",
      "        builder: (context, ref, child) => MxAsyncView<List<${6:Name}Entity>>(",
      "          value: ref.watch(${7:things}Provider),",
      "          loadingLabel: context.l10n.${8:loadingKey},",
      "          data: (items) => items.isEmpty",
      "              ? MxEmptyState(",
      "                  icon: Icons.${9:folder_outlined},",
      "                  title: context.l10n.${10:emptyTitleKey},",
      "                  message: context.l10n.${11:emptyMessageKey},",
      "                )",
      "              : ListView.builder(",
      "                  itemCount: items.length,",
      "                  itemBuilder: (context, index) => $0,",
      "                ),",
      "          // The failure never reaches the user: it tells them nothing they can",
      "          // act on and can carry private content. Map the Failure *type* to",
      "          // ARB copy, never its message.",
      "          //",
      "          // `invalidate`, not `refresh`: nothing here needs the new value as a",
      "          // return, and the rebuild reads it anyway.",
      "          error: (error, stackTrace) => MxErrorState(",
      "            title: context.l10n.${12:errorTitleKey},",
      "            message: context.l10n.${13:errorMessageKey},",
      "            retryLabel: context.l10n.retryAction,",
      "            onRetry: () => ref.invalidate(${7:things}Provider),",
      "          ),",
      "        ),",
      "      ),",
      "    );",
      "  }",
      "}"
    ]
  },
  "memox: DAO": {
    "prefix": "mxdao",
    "scope": "dart",
    "description": "Feature DAO over an already-open AppDatabase. Query -> Stream (watch), mutation -> Future, multi-step -> runInTransaction.",
    "body": [
      "import '../../../../core/database/app_database.dart';",
      "",
      "/// Data access for the ${1:Feature} vertical.",
      "///",
      "/// Receives an already-open [AppDatabase] — `core/database/connection.dart` is",
      "/// the only place that opens one (AD-08). Reads delegate to the typed queries",
      "/// in `queries/${2:feature}.drift`, so every piece of business SQL is checked by",
      "/// `drift_dev` at build time (AD-02).",
      "///",
      "/// This class speaks Drift rows. They stop here: the repository maps them to",
      "/// domain entities and never lets one across (AD-01).",
      "final class ${3:Name}Dao {",
      "  ${3:Name}Dao(this._db);",
      "",
      "  final AppDatabase _db;",
      "",
      "  /// Runs [action] atomically. A thrown error rolls the whole block back.",
      "  Future<T> runInTransaction<T>(Future<T> Function() action) =>",
      "      _db.transaction(action);",
      "",
      "  // ---- reads (Stream) ----------------------------------------------------",
      "",
      "  Stream<List<${4:Row}>> watch${5:Things}() => _db.${6:things}().watch();",
      "",
      "  // ---- writes (Future) ---------------------------------------------------",
      "",
      "  $0",
      "}"
    ]
  },
  "memox: contract fake for presentation tests": {
    "prefix": "mxfake",
    "scope": "dart",
    "description": "Fake of the domain contract. Reads are builders, not values — a single-subscription stream can only be listened to once and retry listens twice.",
    "body": [
      "/// A [${1:Name}Repository] a presentation test can drive.",
      "///",
      "/// A fake of the **domain contract**, not of the DAO: mocking the DAO would tie",
      "/// every screen test to the shape of the Drift row, and would let these tests",
      "/// pass on a repository that maps rows wrongly. What the writes actually do is",
      "/// asserted against real SQLite in `test/features/${2:feature}/data/`.",
      "///",
      "/// Reads are supplied as *builders*, not values: a single-subscription stream",
      "/// can only be listened to once, and retry listens twice.",
      "class Fake${1:Name}Repository implements ${1:Name}Repository {",
      "  Fake${1:Name}Repository({",
      "    Stream<List<${3:Name}Entity>> Function()? ${4:things},",
      "    this.writeFailure,",
      "  }) : _${4:things} = ${4:things} ?? _empty;",
      "",
      "  /// Never emits and never closes: the state a real read is in while SQLite is",
      "  /// still answering.",
      "  factory Fake${1:Name}Repository.pending() => Fake${1:Name}Repository(",
      "    ${4:things}: () => StreamController<List<${3:Name}Entity>>().stream,",
      "  );",
      "",
      "  factory Fake${1:Name}Repository.failing(Object error) =>",
      "      Fake${1:Name}Repository(",
      "        ${4:things}: () => Stream<List<${3:Name}Entity>>.error(error),",
      "      );",
      "",
      "  static Stream<List<${3:Name}Entity>> _empty() =>",
      "      Stream<List<${3:Name}Entity>>.value(const <${3:Name}Entity>[]);",
      "",
      "  final Stream<List<${3:Name}Entity>> Function() _${4:things};",
      "",
      "  /// When set, every write throws it.",
      "  Failure? writeFailure;",
      "",
      "  /// Counts, not booleans: \"did retry re-subscribe\" and \"did a double tap send",
      "  /// two writes\" are both questions about the number.",
      "  int ${4:things}CallCount = 0;",
      "",
      "  @override",
      "  Stream<List<${3:Name}Entity>> watch${5:Things}() {",
      "    ${4:things}CallCount += 1;",
      "",
      "    return _${4:things}();",
      "  }",
      "",
      "  $0",
      "}"
    ]
  },
  "memox: strict visual audit companion": {
    "prefix": "mxaudit",
    "scope": "dart",
    "description": "MX-VIS-001 companion. Mirrored path, strict helper, one call per state, allowance counts exact.",
    "body": [
      "@Tags(<String>['golden', 'screen-audit'])",
      "library;",
      "",
      "import 'package:flutter/widgets.dart';",
      "import 'package:flutter_riverpod/flutter_riverpod.dart';",
      "import 'package:flutter_test/flutter_test.dart';",
      "",
      "/// Strict visual audit for `${1:Name}Screen`.",
      "///",
      "/// Companion of `lib/features/${2:feature}/presentation/${3:name}_screen.dart`, at",
      "/// the mirrored path. MX-VIS-001 checks that this file exists, imports that",
      "/// screen, and calls the strict helper — a file at the right path proves nothing.",
      "///",
      "/// One call per state the user actually spends time in. Loading is normally",
      "/// absent: a progress indicator is mid-animation at any pump, so its paint is",
      "/// not a stable subject — cover it in the widget test instead.",
      "///",
      "/// Allowance counts are exact. `expectedMatches` fails when the number moves in",
      "/// either direction, so a row gaining a control surfaces as a miscount rather",
      "/// than disappearing into a blanket permission.",
      "void main() {",
      "  memoxProductionScreenAuditTest(",
      "    '${3:name}_screen',",
      "    () => $0,",
      "    state: '${4:empty}',",
      "    anchors: <AuditAnchor>[",
      "      AuditAnchor.type('screen_body', ${1:Name}Screen),",
      "    ],",
      "    allowances: <AuditSkipAllowance>[],",
      "  );",
      "}"
    ]
  }
}
