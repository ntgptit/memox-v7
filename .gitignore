# =============================================================================
# Generated code — NOT committed.
#
# CI runs `dart run build_runner build --delete-conflicting-outputs` and then
# fails if the tree is dirty (see flutter-ship/references/ci.md), so generated
# output is verified fresh on every PR instead of being reviewed as a diff.
#
# Consequence to know about: a fresh clone will NOT analyze or run until you
# generate. First command after `flutter pub get` is always:
#     dart run build_runner build --delete-conflicting-outputs
#
# If the project ever reverses this decision, remove this whole block AND drop
# the "generated code is stale" CI step — keeping one without the other gives
# you the downsides of both.
#
# Note: comments must be on their own line. A trailing "# ..." becomes part of
# the pattern and silently stops it matching anything.
# =============================================================================

# riverpod_generator, json_serializable, drift
*.g.dart
# freezed
*.freezed.dart
# drift modular codegen from .drift files (AD-02)
*.drift.dart
# mockito, if it is ever added alongside mocktail
*.mocks.dart
*.config.dart
# flutter gen-l10n output (l10n.yaml: output-dir)
lib/l10n/generated/

# Drift migration fixtures are NOT generated output in the disposable sense —
# they are snapshots of released schema versions, and once the source schema
# moves on they cannot be regenerated. Losing them means migration tests can no
# longer run against old versions, which is the one test that only ever fails
# for real users.
#
# These negations are load-bearing: drift names some helpers *.g.dart, and the
# blanket rule above would otherwise swallow them silently.
!drift_schemas/**
!test/drift/generated/**

# =============================================================================
# Dart / Flutter tooling
# =============================================================================
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec_overrides.yaml
.fvm/flutter_sdk
doc/api/

# pubspec.lock IS committed — this is an application, not a package, so builds
# must be reproducible. Do not add it here.

