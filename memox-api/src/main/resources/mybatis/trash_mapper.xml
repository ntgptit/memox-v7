<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  The one mapper whose statements deliberately read tombstones.

  Every other statement in this codebase carries `delete_batch_id IS NULL`; a Trash that could not
  see deleted rows would have nothing to show. The exception is confined to this file so that
  "which reads can see a tombstone" stays a question with a short, checkable answer (AD-22, BR-257).
-->
<mapper namespace="com.memox.trash.persistence.TrashMapper">

  <resultMap id="deleteBatch" type="com.memox.trash.entity.DeleteBatch">
    <constructor>
      <idArg column="id" javaType="java.lang.String"/>
      <arg column="item_type" javaType="com.memox.trash.enums.TrashItemType"
           typeHandler="com.memox.trash.persistence.TrashItemTypeTypeHandler"/>
      <arg column="root_item_id" javaType="java.lang.String"/>
      <arg column="deleted_at" javaType="java.time.Instant"/>
    </constructor>
  </resultMap>

  <insert id="insertDeleteBatch" parameterType="com.memox.trash.entity.DeleteBatch">
    INSERT INTO delete_batches
      ( id
      , item_type
      , root_item_id
      , deleted_at
      )
    VALUES
      ( #{id}
      , #{itemType,typeHandler=com.memox.trash.persistence.TrashItemTypeTypeHandler}
      , #{rootItemId}
      , #{deletedAt}
      )
  </insert>

  <!--
    The active descendants a deck deletion is about to take with it (BR-258).

    Cycle-safe `UNION` and no depth cap, exactly like `findSubtreeDeckIds`: a cap turns corrupt data
    into a silently short answer, and here that would mean a subtree half marked.

    `delete_batch_id IS NULL` on the recursive step is what keeps a branch that is already in Trash,
    and everything under it, out of the new batch. Restoring this batch will therefore leave that
    branch exactly where it is.
  -->
  <select id="findActiveSubtreeDeckIds" resultType="string">
    WITH RECURSIVE subtree (id) AS (
        SELECT id
          FROM decks
         WHERE id = #{deckId} AND delete_batch_id IS NULL
        UNION
        SELECT d.id
          FROM decks d
          INNER JOIN subtree s ON d.parent_deck_id = s.id
         WHERE d.delete_batch_id IS NULL
    )
    SELECT id FROM subtree
  </select>

  <select id="findActiveCardIdsInDecks" resultType="string">
    SELECT id
      FROM cards
     WHERE deck_id IN
    <foreach collection="deckIds" open="(" separator="," close=")" item="deckId">#{deckId}</foreach>
       AND delete_batch_id IS NULL
  </select>

  <!-- Which of these ids still name an active card, so a batch is never opened over a tombstone. -->
  <select id="findActiveCardIds" resultType="string">
    SELECT id
      FROM cards
     WHERE id IN
    <foreach collection="cardIds" open="(" separator="," close=")" item="cardId">#{cardId}</foreach>
       AND delete_batch_id IS NULL
  </select>

  <!--
    The decks these cards are leaving, read BEFORE the marking.

    `countDirectCards` counts active cards, so once the cards are stamped there is nothing left to
    say where they lived. The emptiness test then runs against the tree the deletion leaves behind
    (BR-260), which is why the read and the count sit on opposite sides of the write.
  -->
  <select id="findSourceDeckIdsOfActiveCards" resultType="string">
    SELECT DISTINCT deck_id
      FROM cards
     WHERE id IN
    <foreach collection="cardIds" open="(" separator="," close=")" item="cardId">#{cardId}</foreach>
       AND delete_batch_id IS NULL
  </select>

  <!--
    Marking is one statement over a set, so a batch is one atomic step rather than N of them.

    `AND delete_batch_id IS NULL` is BR-258's "keeps its old tombstone", written as a predicate: a
    row already carrying a batch is skipped rather than re-stamped. The caller compares the count it
    gets back with the number of ids it read in the same transaction — a short count is not a race
    there, it is a batch that would claim rows it does not hold.
  -->
  <update id="markDecksDeleted">
    UPDATE decks
       SET delete_batch_id = #{batchId}
         , updated_at = #{updatedAt}
     WHERE id IN
    <foreach collection="deckIds" open="(" separator="," close=")" item="deckId">#{deckId}</foreach>
       AND delete_batch_id IS NULL
  </update>

  <update id="markCardsDeleted">
    UPDATE cards
       SET delete_batch_id = #{batchId}
         , updated_at = #{updatedAt}
     WHERE id IN
    <foreach collection="cardIds" open="(" separator="," close=")" item="cardId">#{cardId}</foreach>
       AND delete_batch_id IS NULL
  </update>

  <resultMap id="trashBatchRow" type="com.memox.trash.entity.TrashBatchRow">
    <constructor>
      <idArg column="batch_id" javaType="java.lang.String"/>
      <arg column="item_type" javaType="com.memox.trash.enums.TrashItemType"
           typeHandler="com.memox.trash.persistence.TrashItemTypeTypeHandler"/>
      <arg column="root_item_id" javaType="java.lang.String"/>
      <arg column="deleted_at" javaType="java.time.Instant"/>
      <arg column="item_name" javaType="java.lang.String"/>
      <arg column="origin_deck_id" javaType="java.lang.String"/>
      <arg column="origin_deck_name" javaType="java.lang.String"/>
      <arg column="batch_deck_count" javaType="_long"/>
      <arg column="batch_card_count" javaType="_long"/>
      <arg column="origin_path_json" javaType="java.util.List"
           typeHandler="com.memox.common.tree.AncestryJsonTypeHandler"/>
    </constructor>
  </resultMap>

  <resultMap id="tombstoneDeck" type="com.memox.trash.entity.TombstoneDeck">
    <constructor>
      <idArg column="id" javaType="java.lang.String"/>
      <arg column="parent_deck_id" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <!--
    One row per deletion, newest first — the whole Trash list in one statement.

    **The two LEFT JOINs are exclusive by `item_type`**, so exactly one of them matches and COALESCE
    picks the side that exists. A batch whose item root is gone matches neither and yields a null
    name; the service drops such a row rather than drawing a ghost.

    **`batch_deck_count` / `batch_card_count` count the batch, not the subtree** — what a restore
    would bring back (BR-262). A descendant already in Trash under an older batch carries that older
    id and is absent from both, which is exactly the number a confirmation has to show.

    **A CASE on `item_type`, not a COALESCE over `parent_deck_id`.** The two are equivalent here
    because the joins are exclusive, but the COALESCE spelling is the exact shape BR-57 bans for
    root resolution, and neither a reader nor a guard can tell at a glance that this one is picking
    an origin rather than a root. Saying which branch is which removes the question.

    **`origin_path_json` is one recursive walk for the whole list, not one per row.** The CTE maps
    every deck to its ancestor chain once; the scalar then reads the chain of this row's origin.
    Per-row recursion would be the N+1 the level view names by name. It walks tombstones on purpose:
    the deck a card was deleted from may itself be in Trash today, and "where was this" is still the
    honest answer (BR-267). It is information, never a restore target.

    Translation row 2: `json_group_array(json_object(...))` becomes `json_agg(json_build_object(...))`,
    COALESCEd to '[]' so a top-level item yields an empty array and never null, and explicitly
    ORDERed because SQL promises no aggregate input order.

    `item_name` is a deck name or a card's front. It goes to the owner in a response and is never
    written to a log at any level (BR-267).
  -->
  <select id="findTrashBatchRows" resultMap="trashBatchRow">
    WITH RECURSIVE ancestry (deck_id, node_id, distance) AS (
        SELECT id
             , parent_deck_id
             , 1
          FROM decks
         WHERE parent_deck_id IS NOT NULL
        UNION
        SELECT a.deck_id
             , d.parent_deck_id
             , a.distance + 1
          FROM decks d
          INNER JOIN ancestry a ON d.id = a.node_id
         WHERE d.parent_deck_id IS NOT NULL
    )
    SELECT b.id AS batch_id
         , b.item_type AS item_type
         , b.root_item_id AS root_item_id
         , b.deleted_at AS deleted_at
         , COALESCE(d.name, c.front) AS item_name
         , CASE WHEN b.item_type = 'deck' THEN d.parent_deck_id ELSE c.deck_id END AS origin_deck_id
         , (SELECT COUNT(*) FROM decks bd WHERE bd.delete_batch_id = b.id) AS batch_deck_count
         , (SELECT COUNT(*) FROM cards bc WHERE bc.delete_batch_id = b.id) AS batch_card_count
         , (SELECT COALESCE(json_agg(json_build_object('id', a.node_id, 'name', ad.name,
                                                       'distance', a.distance)
                                     ORDER BY a.distance), '[]'::json)
              FROM ancestry a
              INNER JOIN decks ad ON ad.id = a.node_id
             WHERE a.deck_id = CASE WHEN b.item_type = 'deck' THEN d.parent_deck_id
                                    ELSE c.deck_id END) AS origin_path_json
         , (SELECT od.name
              FROM decks od
             WHERE od.id = CASE WHEN b.item_type = 'deck' THEN d.parent_deck_id
                                ELSE c.deck_id END) AS origin_deck_name
      FROM delete_batches b
      LEFT JOIN decks d ON b.item_type = 'deck' AND d.id = b.root_item_id
      LEFT JOIN cards c ON b.item_type = 'card' AND c.id = b.root_item_id
     ORDER BY b.deleted_at DESC, b.id DESC
  </select>

  <select id="findBatchById" resultMap="deleteBatch">
    SELECT id
         , item_type
         , root_item_id
         , deleted_at
      FROM delete_batches
     WHERE id = #{batchId}
  </select>

  <!--
    The tombstone rows themselves, read without the active filter every other statement carries.

    Both are scoped to a batch as well as an id, so a stale batch id cannot read a row that has since
    been restored: the pair either matches or the operation is a not-found.
  -->
  <select id="findTombstoneDeckInBatch" resultMap="tombstoneDeck">
    SELECT id
         , parent_deck_id
      FROM decks
     WHERE id = #{deckId} AND delete_batch_id = #{batchId}
  </select>

  <select id="findTombstoneCardIdInBatch" resultType="string">
    SELECT id
      FROM cards
     WHERE id = #{cardId} AND delete_batch_id = #{batchId}
  </select>

  <update id="restoreDecksInBatch">
    UPDATE decks
       SET delete_batch_id = NULL
         , updated_at = #{updatedAt}
     WHERE delete_batch_id = #{batchId}
  </update>

  <update id="restoreCardsInBatch">
    UPDATE cards
       SET delete_batch_id = NULL
         , updated_at = #{updatedAt}
     WHERE delete_batch_id = #{batchId}
  </update>

  <!--
    Safe only AFTER the rows have been cleared.

    Both tombstone columns carry an `ON DELETE CASCADE` to this table, so deleting the batch while
    its rows still name it would take them with it — a restore that hard-deletes what it was
    restoring.
  -->
  <delete id="deleteBatch">
    DELETE FROM delete_batches WHERE id = #{batchId}
  </delete>

  <!--
    Batches whose retention has run out, oldest first (BR-264).

    `&lt;=`, so a batch at exactly thirty days is eligible; the caller computes the cutoff from the
    injected clock, never from SQL's own `now()`.

    Oldest first because a purge cascade walks DOWN the deck tree, and an ancestor is always deleted
    no earlier than its descendants — so sweeping in this order means a descendant's own batch is
    already gone by the time its ancestor's turn arrives.
  -->
  <select id="findEligibleBatches" resultMap="deleteBatch">
    SELECT id
         , item_type
         , root_item_id
         , deleted_at
      FROM delete_batches
     WHERE deleted_at &lt;= #{cutoff}
     ORDER BY deleted_at ASC, id ASC
  </select>

  <!--
    BR-265's precondition, as one number.

    Purging a batch deletes its deck rows, and `decks.parent_deck_id ON DELETE CASCADE` then takes
    EVERYTHING under them — it has never heard of a batch. So before any of that runs, this counts
    the rows the cascade would reach that the caller is not allowed to remove: still active, or
    tombstoned under a batch outside `allowedBatchIds`. Anything above zero and the batch is left
    alone, whole.

    **The allowed set is a parameter, not the retention cutoff**, because two callers mean different
    things by "allowed": the sweep passes every batch past retention (BR-264), and a user-requested
    purge would pass exactly what the confirmation named (BR-266). One statement, two policies, and
    neither can reach a row the other would have protected.

    A card batch marks no decks, so the subtree is empty and the answer is 0 — purging one card can
    reach nothing but itself.
  -->
  <select id="countPurgeBlockers" resultType="long">
    WITH RECURSIVE subtree (id) AS (
        SELECT id
          FROM decks
         WHERE delete_batch_id = #{batchId}
        UNION
        SELECT d.id
          FROM decks d
          INNER JOIN subtree s ON d.parent_deck_id = s.id
    )
    SELECT (SELECT COUNT(*)
              FROM decks d
             WHERE d.id IN (SELECT id FROM subtree)
               AND (d.delete_batch_id IS NULL
                    OR d.delete_batch_id NOT IN
    <foreach collection="allowedBatchIds" open="(" separator="," close=")" item="allowedId">#{allowedId}</foreach>))
         + (SELECT COUNT(*)
              FROM cards c
             WHERE c.deck_id IN (SELECT id FROM subtree)
               AND (c.delete_batch_id IS NULL
                    OR c.delete_batch_id NOT IN
    <foreach collection="allowedBatchIds" open="(" separator="," close=")" item="allowedId">#{allowedId}</foreach>))
  </select>

</mapper>
