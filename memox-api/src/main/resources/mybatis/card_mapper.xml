<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.memox.card.persistence.CardMapper">

  <resultMap id="card" type="com.memox.card.entity.Card">
    <constructor>
      <idArg column="id" javaType="java.lang.String"/>
      <arg column="deck_id" javaType="java.lang.String"/>
      <arg column="front" javaType="java.lang.String"/>
      <arg column="back" javaType="java.lang.String"/>
      <!-- Named explicitly rather than left to the registry: is_flagged is SMALLINT, and the
           built-in boolean handler only reads it by grace of the PostgreSQL driver. Stating the
           handler here means the read path exercises the same code the first flag WRITE will. -->
      <arg column="is_flagged" javaType="_boolean" typeHandler="com.memox.common.mybatis.BooleanSmallIntTypeHandler"/>
      <arg column="example" javaType="java.lang.String"/>
      <arg column="hint" javaType="java.lang.String"/>
      <arg column="pronunciation" javaType="java.lang.String"/>
      <arg column="created_at" javaType="java.time.Instant"/>
      <arg column="updated_at" javaType="java.time.Instant"/>
    </constructor>
  </resultMap>

  <insert id="insertCard" parameterType="com.memox.card.entity.Card">
    INSERT INTO cards (
      id, deck_id, front, back, front_folded, back_folded,
      example, hint, pronunciation, created_at, updated_at
    ) VALUES (
      #{id}, #{deckId}, #{front}, #{back}, LOWER(#{front}), LOWER(#{back}),
      #{example}, #{hint}, #{pronunciation}, #{createdAt}, #{updatedAt}
    )
  </insert>

  <insert id="insertInitialStudyState">
    INSERT INTO card_study_states (
      card_id, scheduler_type, scheduler_version, scheduler_generation
    ) VALUES (
      #{cardId}, #{schedulerType}, #{schedulerVersion}, #{schedulerGeneration}
    )
  </insert>

  <select id="activeDeckExists" resultType="boolean">
    SELECT EXISTS (
      SELECT 1
      FROM decks
      WHERE id = #{deckId}
        AND delete_batch_id IS NULL
    )
  </select>

  <!-- Same contract as deck_mapper.xml: see the note on its orderBySlice fragment for why ${} is
       safe for a sort column and unsafe for anything else. -->
  <sql id="orderBySlice">
    ORDER BY
    <foreach collection="slice.sorts" item="sort" separator=", ">${sort.column} ${sort.direction}${sort.nulls.sql}</foreach>
  </sql>

  <select id="findActiveCardsByDeck" resultMap="card">
    SELECT c.id, c.deck_id, c.front, c.back, c.is_flagged, c.example, c.hint, c.pronunciation,
           c.created_at, c.updated_at
    FROM cards c
    WHERE c.deck_id = #{deckId}
      AND c.delete_batch_id IS NULL
    <include refid="orderBySlice"/>
    LIMIT #{slice.limit}
    OFFSET #{slice.offset}
  </select>

  <resultMap id="cardListItem" type="com.memox.card.entity.CardListItem">
    <constructor>
      <idArg column="id" javaType="java.lang.String"/>
      <arg column="deck_id" javaType="java.lang.String"/>
      <arg column="front" javaType="java.lang.String"/>
      <arg column="back" javaType="java.lang.String"/>
      <arg column="is_flagged" javaType="_boolean" typeHandler="com.memox.common.mybatis.BooleanSmallIntTypeHandler"/>
      <arg column="example" javaType="java.lang.String"/>
      <arg column="hint" javaType="java.lang.String"/>
      <arg column="pronunciation" javaType="java.lang.String"/>
      <arg column="created_at" javaType="java.time.Instant"/>
      <arg column="updated_at" javaType="java.time.Instant"/>
      <arg column="scheduler_type" javaType="com.memox.common.scheduler.SchedulerType" typeHandler="com.memox.common.mybatis.SchedulerTypeTypeHandler"/>
      <arg column="scheduler_generation" javaType="_int"/>
      <arg column="learned_at" javaType="java.time.Instant"/>
      <arg column="due_at" javaType="java.time.Instant"/>
      <arg column="last_answered_at" javaType="java.time.Instant"/>
      <arg column="answer_count" javaType="_int"/>
      <arg column="lapse_count" javaType="_int"/>
      <arg column="current_box" javaType="java.lang.Integer"/>
      <arg column="ease_factor" javaType="java.lang.Double"/>
      <arg column="interval_days" javaType="java.lang.Integer"/>
      <arg column="repetitions" javaType="java.lang.Integer"/>
      <arg column="tag_names" javaType="java.util.List" typeHandler="com.memox.common.mybatis.UnitSeparatedListTypeHandler"/>
    </constructor>
  </resultMap>

  <resultMap id="cardStateCounts" type="com.memox.card.entity.CardStateCounts">
    <constructor>
      <arg column="new_count" javaType="_long"/>
      <arg column="learning_count" javaType="_long"/>
      <arg column="reviewing_count" javaType="_long"/>
      <arg column="mastered_count" javaType="_long"/>
    </constructor>
  </resultMap>

  <!--
    The filter, built from a whitelist rather than from a client string. Drift compiles $predicate at
    build time from Dart expressions; here every branch is written out and every value is a bound
    #{} parameter. Nothing a client sends is ever concatenated.

    The tag filter is OR-semantics (BR-231) via EXISTS rather than a join, which is what keeps one
    card to one row when it carries several of the selected tags (BR-252). A join would multiply it.

    An empty tagIds list means "no tag filter" and is checked here, because PostgreSQL rejects
    IN () outright — translation row 9.
  -->
  <sql id="cardListPredicate">
    c.delete_batch_id IS NULL
    <if test="filter.deckId != null and !filter.includeSubtree">
      AND c.deck_id = #{filter.deckId}
    </if>
    <if test="filter.deckId != null and filter.includeSubtree">
      AND c.deck_id IN (
        WITH RECURSIVE subtree (id) AS (
            SELECT id FROM decks WHERE id = #{filter.deckId} AND delete_batch_id IS NULL
            UNION
            SELECT d.id FROM decks d INNER JOIN subtree s2 ON d.parent_deck_id = s2.id
             WHERE d.delete_batch_id IS NULL
        )
        SELECT id FROM subtree)
    </if>
    <if test="filter.flagged != null">
      AND c.is_flagged = #{filter.flagged,typeHandler=com.memox.common.mybatis.BooleanSmallIntTypeHandler,jdbcType=SMALLINT}
    </if>
    <if test="filter.hasTagFilter()">
      AND EXISTS (SELECT 1 FROM card_tags ct
                   WHERE ct.card_id = c.id
                     AND ct.tag_id IN
        <foreach collection="filter.tagIds" open="(" separator="," close=")" item="tagId">#{tagId}</foreach>)
    </if>
    <if test="filter.searchFolded != null">
      AND (strpos(c.front_folded, #{filter.searchFolded}) &gt; 0
        OR strpos(c.back_folded, #{filter.searchFolded}) &gt; 0)
    </if>
  </sql>

  <!--
    Translation row 1: GROUP_CONCAT has no defined order in SQLite and string_agg has none either
    unless given one. Tag strings that reorder between two reads make the list flicker, so the
    ORDER BY inside the aggregate is not optional.
  -->
  <select id="findCardListItems" resultMap="cardListItem">
    SELECT c.id, c.deck_id, c.front, c.back, c.is_flagged, c.example, c.hint, c.pronunciation,
           c.created_at, c.updated_at,
           s.scheduler_type, s.scheduler_generation, s.learned_at, s.due_at, s.last_answered_at,
           s.answer_count, s.lapse_count, s.current_box, s.ease_factor, s.interval_days,
           s.repetitions,
           (SELECT string_agg(t.name, chr(31) ORDER BY t.name, t.id)
              FROM card_tags ct
              INNER JOIN tags t ON t.id = ct.tag_id
             WHERE ct.card_id = c.id) AS tag_names
      FROM cards c
      INNER JOIN card_study_states s ON s.card_id = c.id
     WHERE <include refid="cardListPredicate"/>
    <include refid="orderBySlice"/>
    LIMIT #{slice.limit}
    OFFSET #{slice.offset}
  </select>

  <select id="countCardListItems" resultType="long">
    SELECT COUNT(*)
      FROM cards c
      INNER JOIN card_study_states s ON s.card_id = c.id
     WHERE <include refid="cardListPredicate"/>
  </select>

  <!-- Every matching id, unpaged: what "select all" in the management list acts on. -->
  <select id="findCardIdsMatching" resultType="java.lang.String">
    SELECT c.id
      FROM cards c
      INNER JOIN card_study_states s ON s.card_id = c.id
     WHERE <include refid="cardListPredicate"/>
    <include refid="orderBySlice"/>
  </select>

  <!--
    The four stages partition the deck's active cards, so they sum to its total. Both schedulers are
    decided in one pass because card_study_states carries scheduler_type denormalised; the
    thresholds are bound parameters, not literals, so a boundary moves in one place.
  -->
  <select id="countCardStatesByDeck" resultMap="cardStateCounts">
    SELECT
      COALESCE(SUM(CASE WHEN s.learned_at IS NULL THEN 1 ELSE 0 END), 0) AS new_count,
      COALESCE(SUM(CASE WHEN s.learned_at IS NOT NULL
                    AND ((s.scheduler_type = 'eight_box' AND s.current_box &lt; #{thresholds.reviewingBox})
                      OR (s.scheduler_type = 'sm2' AND s.interval_days &lt; #{thresholds.reviewingDays}))
                   THEN 1 ELSE 0 END), 0) AS learning_count,
      COALESCE(SUM(CASE WHEN s.learned_at IS NOT NULL
                    AND ((s.scheduler_type = 'eight_box'
                          AND s.current_box &gt;= #{thresholds.reviewingBox}
                          AND s.current_box &lt; #{thresholds.masteredBox})
                      OR (s.scheduler_type = 'sm2'
                          AND s.interval_days &gt;= #{thresholds.reviewingDays}
                          AND s.interval_days &lt; #{thresholds.masteredDays}))
                   THEN 1 ELSE 0 END), 0) AS reviewing_count,
      COALESCE(SUM(CASE WHEN s.learned_at IS NOT NULL
                    AND ((s.scheduler_type = 'eight_box' AND s.current_box &gt;= #{thresholds.masteredBox})
                      OR (s.scheduler_type = 'sm2' AND s.interval_days &gt;= #{thresholds.masteredDays}))
                   THEN 1 ELSE 0 END), 0) AS mastered_count
    FROM cards c
    INNER JOIN card_study_states s ON s.card_id = c.id
    WHERE c.deck_id = #{deckId} AND c.delete_batch_id IS NULL
  </select>

  <!--
    Twenty columns, which is the whole table, because BR-242 says the screen shows what the row
    stored. Drift uses SELECT * for exactly this and warns above it: a column dropped from a
    projection is a fact that silently stops being displayed. The Phase 2 plan's projection dropped
    comparison_version.

    "action" stays quoted — it is a reserved word and V2 created the column quoted.
    used_hint is SMALLINT and NULLABLE, so it maps to java.lang.Boolean through the smallint
    handler: "we do not know" is a different answer from "no hint was used".
  -->
  <resultMap id="cardHistoryEntry" type="com.memox.card.entity.CardHistoryEntry">
    <constructor>
      <idArg column="id" javaType="java.lang.String"/>
      <arg column="card_id" javaType="java.lang.String"/>
      <arg column="session_id" javaType="java.lang.String"/>
      <arg column="scheduler_type" javaType="com.memox.common.scheduler.SchedulerType" typeHandler="com.memox.common.mybatis.SchedulerTypeTypeHandler"/>
      <arg column="scheduler_generation" javaType="_int"/>
      <arg column="kind" javaType="java.lang.String"/>
      <arg column="mode" javaType="java.lang.String"/>
      <arg column="outcome_reason" javaType="java.lang.String"/>
      <arg column="comparison_version" javaType="java.lang.Integer"/>
      <arg column="used_hint" javaType="java.lang.Boolean" typeHandler="com.memox.common.mybatis.BooleanSmallIntTypeHandler"/>
      <arg column="action" javaType="java.lang.String"/>
      <arg column="answered_at" javaType="java.time.Instant"/>
      <arg column="next_due_at" javaType="java.time.Instant"/>
      <arg column="previous_box" javaType="java.lang.Integer"/>
      <arg column="next_box" javaType="java.lang.Integer"/>
      <arg column="previous_ease_factor" javaType="java.lang.Double"/>
      <arg column="next_ease_factor" javaType="java.lang.Double"/>
      <arg column="previous_interval_days" javaType="java.lang.Integer"/>
      <arg column="next_interval_days" javaType="java.lang.Integer"/>
      <arg column="direction" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <sql id="historyColumns">
    id, card_id, session_id, scheduler_type, scheduler_generation, kind, mode,
    outcome_reason, comparison_version, used_hint, "action", answered_at, next_due_at,
    previous_box, next_box, previous_ease_factor, next_ease_factor,
    previous_interval_days, next_interval_days, direction
  </sql>

  <!--
    The newest page of one card's history (BR-241).

    answered_at DESC, id DESC — and the tie-break is load-bearing. Two turns of one session can
    share a millisecond; without id the order is not total, and a page boundary falling inside a
    group of equal timestamps loses rows or repeats them however the cursor is built.

    The caller asks for one row MORE than the page size, so "is there another page" is answered by
    the read rather than guessed from a short result.
  -->
  <select id="findCardHistoryFirstPage" resultMap="cardHistoryEntry">
    SELECT <include refid="historyColumns"/>
    FROM study_answers
    WHERE card_id = #{cardId}
    ORDER BY answered_at DESC, id DESC
    LIMIT #{limit}
  </select>

  <!--
    The same page resumed after a cursor. A separate statement rather than a nullable cursor on the
    one above: an (:hasCursor = 0 OR ...) chain is a predicate the index cannot stop early through,
    which would undo what idx_study_answers_card is for.

    The row-value comparison says exactly what Drift's `answered_at < :x OR (answered_at = :x AND
    id < :y)` says. Drift wrote it long-hand because its analyser does not parse row values, not
    because the semantics differ; PostgreSQL parses it and can drive the index from it.

    Strictly after, never <=: the cursor is the last row of the previous page, and including it
    again is the duplicate BR-241 forbids.
  -->
  <select id="findCardHistoryAfter" resultMap="cardHistoryEntry">
    SELECT <include refid="historyColumns"/>
    FROM study_answers
    WHERE card_id = #{cardId}
      AND (answered_at, id) &lt; (#{cursor.answeredAt}, #{cursor.id})
    ORDER BY answered_at DESC, id DESC
    LIMIT #{limit}
  </select>

  <!--
    Detail is findCardListItems narrowed to one id and deliberately the same projection — Drift says
    so, and gives the reason: detail and the row it was opened from cannot disagree about a card's
    state or its chips. That is why there is no separate CardDetail result map.

    INNER JOIN, and the tombstone check: a card in Trash reads as not-found here rather than showing
    its content (BR-245, BR-257).
  -->
  <select id="findCardDetailById" resultMap="cardListItem">
    SELECT c.id, c.deck_id, c.front, c.back, c.is_flagged, c.example, c.hint, c.pronunciation,
           c.created_at, c.updated_at,
           s.scheduler_type, s.scheduler_generation, s.learned_at, s.due_at, s.last_answered_at,
           s.answer_count, s.lapse_count, s.current_box, s.ease_factor, s.interval_days,
           s.repetitions,
           (SELECT string_agg(t.name, chr(31) ORDER BY t.name, t.id)
              FROM card_tags ct
              INNER JOIN tags t ON t.id = ct.tag_id
             WHERE ct.card_id = c.id) AS tag_names
      FROM cards c
      INNER JOIN card_study_states s ON s.card_id = c.id
     WHERE c.id = #{cardId} AND c.delete_batch_id IS NULL
  </select>

  <resultMap id="cardDeckContext" type="com.memox.card.entity.CardDeckContext">
    <constructor>
      <idArg column="card_id" javaType="java.lang.String"/>
      <arg column="deck_id" javaType="java.lang.String"/>
      <arg column="root_deck_id" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <!--
    Where the whole batch currently lives, in one statement. A bulk move validates every card
    against the same target, so a lookup per card would be N round trips inside the write
    transaction.

    A trashed card simply does not come back, which is how the service notices one is in the batch
    (BR-245, BR-257) — it compares the rows it got against the ids it asked for.
  -->
  <select id="findCardDeckContextForIds" resultMap="cardDeckContext">
    SELECT c.id AS card_id, d.id AS deck_id, d.root_deck_id AS root_deck_id
    FROM cards c
    INNER JOIN decks d ON d.id = c.deck_id
    WHERE c.id IN
    <foreach collection="cardIds" open="(" separator="," close=")" item="cardId">#{cardId}</foreach>
      AND c.delete_batch_id IS NULL
      AND d.delete_batch_id IS NULL
  </select>

  <update id="moveCardsToDeck">
    UPDATE cards
    SET deck_id = #{deckId}, updated_at = #{updatedAt}
    WHERE id IN
    <foreach collection="cardIds" open="(" separator="," close=")" item="cardId">#{cardId}</foreach>
      AND delete_batch_id IS NULL
  </update>

  <!-- Translation row 6: a Java boolean bound into a SMALLINT column needs the handler named. -->
  <update id="setCardsFlagByIds">
    UPDATE cards
    SET is_flagged = #{flagged,typeHandler=com.memox.common.mybatis.BooleanSmallIntTypeHandler,jdbcType=SMALLINT},
        updated_at = #{updatedAt}
    WHERE id IN
    <foreach collection="cardIds" open="(" separator="," close=")" item="cardId">#{cardId}</foreach>
      AND delete_batch_id IS NULL
  </update>

  <!--
    Content columns only. BR-92: editing a card never touches is_flagged and never touches a
    scheduler column — content survives every reset, and the schedule is not the content's business.

    LOWER() is the fold, and it agrees with the Dart side's raw.trim().toLowerCase() because the
    service trims before binding. A test pins that over a mixed-script string rather than assuming
    it holds for the scripts this app ships.
  -->
  <update id="updateCardContent">
    UPDATE cards
    SET front = #{front}, back = #{back},
        front_folded = LOWER(#{front}), back_folded = LOWER(#{back}),
        example = #{example}, hint = #{hint}, pronunciation = #{pronunciation},
        updated_at = #{updatedAt}
    WHERE id = #{id}
      AND delete_batch_id IS NULL
  </update>

  <!-- The write paths read the card back so the caller sees what was stored, not what was sent. -->
  <select id="findCardById" resultMap="card">
    SELECT c.id, c.deck_id, c.front, c.back, c.is_flagged, c.example, c.hint, c.pronunciation,
           c.created_at, c.updated_at
    FROM cards c
    WHERE c.id = #{cardId}
      AND c.delete_batch_id IS NULL
  </select>

  <select id="countActiveCardsByDeck" resultType="long">
    SELECT COUNT(*)
    FROM cards
    WHERE deck_id = #{deckId}
      AND delete_batch_id IS NULL
  </select>
</mapper>
