# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#   cp .env.example .env
#
# Read by `docker compose` for the container, and exported by you for the app.
# The two are separate: compose builds the database from these, the application
# reads MEMOX_DB_* from the environment. A value changed in only one place shows
# up as `connection refused`, not as a config error.

# --- the application's development database (compose service `db`) -----------

MEMOX_DB_NAME=memox
MEMOX_DB_USERNAME=giapnt
MEMOX_DB_PASSWORD=

# This machine already runs PostgreSQL 17 as a Windows service on 5432. Leave
# this at 5432 only if that service is stopped; otherwise pick a free port AND
# change the port in MEMOX_DB_URL to match.
MEMOX_DB_PORT=5432
MEMOX_DB_URL=jdbc:postgresql://localhost:5432/memox

# --- the test database, only for MEMOX_TEST_DATABASE=local -------------------
#
# Not needed when Docker is available: Testcontainers provisions its own.
# The password here is a throwaway for a disposable container, not a secret.

MEMOX_TEST_DB_PORT=5433
# MEMOX_TEST_DATABASE=local
# MEMOX_TEST_DB_URL=jdbc:postgresql://localhost:5433/memox_test
# MEMOX_TEST_DB_USERNAME=memox
# MEMOX_TEST_DB_PASSWORD=memox
