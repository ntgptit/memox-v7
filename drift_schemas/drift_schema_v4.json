        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL, \"name_folded\" TEXT NOT NULL, \"owner_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "decks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL, \"parent_deck_id\" TEXT NULL REFERENCES decks(id)ON DELETE CASCADE, \"root_deck_id\" TEXT NOT NULL, \"content_type\" TEXT NOT NULL CHECK (content_type IN ('unset', 'card', 'deck')), \"owner_id\" TEXT NULL, \"scheduler_type\" TEXT NULL CHECK (scheduler_type IS NULL OR scheduler_type IN ('eight_box', 'sm2')), \"scheduler_version\" INTEGER NULL, \"scheduler_config\" TEXT NULL, \"scheduler_generation\" INTEGER NULL, \"first_answered_at\" INTEGER NULL, \"source_template_id\" TEXT NULL, \"source_template_version\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cards\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"deck_id\" TEXT NOT NULL REFERENCES decks(id)ON DELETE CASCADE, \"front\" TEXT NOT NULL, \"back\" TEXT NOT NULL, \"front_folded\" TEXT NOT NULL DEFAULT '', \"back_folded\" TEXT NOT NULL DEFAULT '', \"is_flagged\" INTEGER NOT NULL DEFAULT 0 CHECK (is_flagged IN (0, 1)), \"example\" TEXT NULL, \"hint\" TEXT NULL, \"pronunciation\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
